10 REM *** TIC-TAC-TOE FOR TRS-80 LEVEL II BASIC ***
20 CLEAR 1000
30 DIM BD(9),SS$(9),PL(10),IX(10),VL(10),MV(10)
40 DIM OD(9),AL(10),BT(10),CA(9)
50 OD(1)=5:OD(2)=1:OD(3)=3:OD(4)=7:OD(5)=9
60 OD(6)=2:OD(7)=4:OD(8)=6:OD(9)=8
70 RANDOM
80 PW=0:CW=0:TI=0
90 CLS
100 INPUT "WHAT IS YOUR NAME";NM$
110 PRINT:PRINT "HELLO, ";NM$;"! I AM GLAD TO MEET YOU."
120 PRINT:PRINT "WOULD YOU LIKE ME TO PLAY AS:"
130 PRINT "1) A NOVICE"
140 PRINT "2) A GOOD PLAYER"
150 PRINT "3) AN EXPERT"
160 PRINT "PRESS 1, 2, OR 3."
170 KY$=INKEY$:IF KY$="" THEN 170
180 IF KY$="1" THEN LV=1:GOTO 215
190 IF KY$="2" THEN LV=2:GOTO 215
200 IF KY$="3" THEN LV=3:GOTO 215
210 GOTO 170
215 KY$=INKEY$:IF KY$<>"" THEN 215
220 PRINT:PRINT "YOU CHOSE ";
230 ON LV GOTO 240,250,260
240 PRINT "A NOVICE.":GOTO 280
250 PRINT "A GOOD PLAYER.":GOTO 280
260 PRINT "AN EXPERT."
280 PRINT
290 INPUT "WOULD YOU LIKE TO BE X OR O";AN$
300 IF AN$="X" THEN US$="X":ME$="O":GOTO 330
310 IF AN$="O" THEN US$="O":ME$="X":GOTO 330
320 PRINT "PLEASE TYPE X OR O.":GOTO 290
330 FOR K=1 TO 9:BD(K)=0:NEXT K
340 FI=RND(2)
350 IF FI=1 THEN TN=-1 ELSE TN=1
360 GOSUB 2500
370 IF TN=-1 THEN PRINT "YOU HAVE THE FIRST MOVE, ";NM$;"." ELSE PRINT "I HAVE THE FIRST MOVE, ";NM$;"."
380 IF TN=-1 THEN GOSUB 1000 ELSE GOSUB 1500
390 GOSUB 2500
400 GOSUB 4000
410 IF WN=1 THEN 480
420 IF WN=-1 THEN 500
430 GOSUB 4100
440 IF FL=1 THEN 520
450 TN=-TN
460 GOTO 380
480 PRINT "I WON THAT GAME, ";NM$;"!"
490 CW=CW+1:GOTO 540
500 PRINT "YOU WON, ";NM$;"! WELL PLAYED!"
510 PW=PW+1:GOTO 540
520 PRINT "THAT GAME IS A TIE."
530 TI=TI+1
540 DG=PW+CW
550 IF DG=0 THEN PC=0 ELSE PC=100*PW/DG
560 PRINT
570 PRINT "YOUR WINS:";PW;"  MY WINS:";CW;"  TIES:";TI
580 PRINT "YOUR WIN PERCENTAGE IS";INT(PC*10+.5)/10;"PERCENT."
590 PRINT:PRINT "SHALL WE PLAY AGAIN? Y/N"
600 KY$=INKEY$:IF KY$="" THEN 600
610 IF KY$="Y" THEN 640
620 IF KY$<>"N" THEN 600
630 GOTO 5000
640 KY$=INKEY$:IF KY$<>"" THEN 640
650 GOTO 330
1000 PRINT:PRINT "PRESS T,Y,U,G,H,J,B,N, OR M."
1010 PRINT "YOUR MOVE, ";NM$;"?";
1020 KY$=INKEY$:IF KY$="" THEN 1020
1030 MO=0
1040 IF KY$="T" THEN MO=1
1050 IF KY$="Y" THEN MO=2
1060 IF KY$="U" THEN MO=3
1070 IF KY$="G" THEN MO=4
1080 IF KY$="H" THEN MO=5
1090 IF KY$="J" THEN MO=6
1100 IF KY$="B" THEN MO=7
1110 IF KY$="N" THEN MO=8
1120 IF KY$="M" THEN MO=9
1130 IF MO=0 THEN 1020
1140 IF BD(MO)=0 THEN BD(MO)=-1:GOTO 1180
1150 PRINT:PRINT "THAT SQUARE IS ALREADY TAKEN."
1160 KY$=INKEY$:IF KY$<>"" THEN 1160
1170 GOTO 1000
1180 KY$=INKEY$:IF KY$<>"" THEN 1180
1190 RETURN
1500 PRINT:PRINT "I AM THINKING..."
1510 IF LV=1 THEN GOSUB 1600:RETURN
1520 IF LV=2 THEN GOSUB 1700:RETURN
1530 GOSUB 2000
1540 IF NC=9 THEN MO=5:BD(MO)=1:RETURN
1550 TS=1:GOSUB 1900
1560 IF MO>0 THEN BD(MO)=1:RETURN
1570 TS=-1:GOSUB 1900
1580 IF MO>0 THEN BD(MO)=1:RETURN
1590 D=0:PL(0)=1:AL(0)=-99:BT(0)=99
1592 GOSUB 3000
1594 BD(MO)=1
1596 RETURN
1600 GOSUB 2000
1610 MO=CA(RND(NC))
1620 BD(MO)=1
1630 RETURN
1700 TS=1:GOSUB 1900
1710 IF MO>0 THEN BD(MO)=1:RETURN
1720 TS=-1:GOSUB 1900
1730 IF MO>0 THEN BD(MO)=1:RETURN
1740 IF BD(5)=0 THEN MO=5:BD(MO)=1:RETURN
1750 NC=0
1760 IF BD(1)=-1 AND BD(9)=0 THEN NC=NC+1:CA(NC)=9
1770 IF BD(3)=-1 AND BD(7)=0 THEN NC=NC+1:CA(NC)=7
1780 IF BD(7)=-1 AND BD(3)=0 THEN NC=NC+1:CA(NC)=3
1790 IF BD(9)=-1 AND BD(1)=0 THEN NC=NC+1:CA(NC)=1
1800 IF NC>0 THEN MO=CA(RND(NC)):BD(MO)=1:RETURN
1810 NC=0
1820 IF BD(1)=0 THEN NC=NC+1:CA(NC)=1
1830 IF BD(3)=0 THEN NC=NC+1:CA(NC)=3
1840 IF BD(7)=0 THEN NC=NC+1:CA(NC)=7
1850 IF BD(9)=0 THEN NC=NC+1:CA(NC)=9
1860 IF NC>0 THEN MO=CA(RND(NC)):BD(MO)=1:RETURN
1870 GOSUB 2000
1880 MO=CA(RND(NC)):BD(MO)=1
1890 RETURN
1900 MO=0:K=1
1910 IF K>9 THEN RETURN
1920 IF BD(K)<>0 THEN K=K+1:GOTO 1910
1930 BD(K)=TS
1940 GOSUB 4000
1950 BD(K)=0
1960 IF WN=TS THEN MO=K:RETURN
1970 K=K+1:GOTO 1910
2000 NC=0
2010 FOR K=1 TO 9
2020 IF BD(K)=0 THEN NC=NC+1:CA(NC)=K
2030 NEXT K
2040 RETURN
2500 CLS
2510 FOR K=1 TO 9
2520 SS$(K)=" "
2530 IF BD(K)=1 THEN SS$(K)=ME$
2540 IF BD(K)=-1 THEN SS$(K)=US$
2550 NEXT K
2560 PRINT "   I   I        MOVE KEYS"
2570 PRINT " ";SS$(1);" I ";SS$(2);" I ";SS$(3);"        T Y U"
2580 PRINT "   I   I"
2590 PRINT "---+---+---"
2600 PRINT "   I   I"
2610 PRINT " ";SS$(4);" I ";SS$(5);" I ";SS$(6);"        G H J"
2620 PRINT "   I   I"
2630 PRINT "---+---+---"
2640 PRINT "   I   I"
2650 PRINT " ";SS$(7);" I ";SS$(8);" I ";SS$(9);"        B N M"
2660 PRINT "   I   I"
2670 PRINT
2680 PRINT NM$;" = ";US$;"    I AM ";ME$
2690 RETURN
3000 GOSUB 4000
3010 IF WN=1 THEN RS=10-D:RETURN
3020 IF WN=-1 THEN RS=D-10:RETURN
3030 GOSUB 4100
3040 IF FL=1 THEN RS=0:RETURN
3050 IF PL(D)=1 THEN VL(D)=-99 ELSE VL(D)=99
3060 IX(D)=1
3070 IF IX(D)>9 THEN RS=VL(D):RETURN
3080 MV(D)=OD(IX(D))
3090 IF BD(MV(D))<>0 THEN IX(D)=IX(D)+1:GOTO 3070
3100 BD(MV(D))=PL(D)
3110 D=D+1
3120 PL(D)=-PL(D-1):AL(D)=AL(D-1):BT(D)=BT(D-1)
3130 GOSUB 3000
3140 D=D-1
3150 BD(MV(D))=0
3160 IF PL(D)=-1 THEN 3250
3170 IF RS<=VL(D) THEN 3200
3180 VL(D)=RS
3190 IF D=0 THEN MO=MV(D)
3200 IF VL(D)>AL(D) THEN AL(D)=VL(D)
3210 GOTO 3280
3250 IF RS>=VL(D) THEN 3270
3260 VL(D)=RS
3270 IF VL(D)<BT(D) THEN BT(D)=VL(D)
3280 IF BT(D)<=AL(D) THEN RS=VL(D):RETURN
3290 IX(D)=IX(D)+1:GOTO 3070
4000 WN=0
4010 IF BD(1)<>0 AND BD(1)=BD(2) AND BD(2)=BD(3) THEN WN=BD(1):RETURN
4020 IF BD(4)<>0 AND BD(4)=BD(5) AND BD(5)=BD(6) THEN WN=BD(4):RETURN
4030 IF BD(7)<>0 AND BD(7)=BD(8) AND BD(8)=BD(9) THEN WN=BD(7):RETURN
4040 IF BD(1)<>0 AND BD(1)=BD(4) AND BD(4)=BD(7) THEN WN=BD(1):RETURN
4050 IF BD(2)<>0 AND BD(2)=BD(5) AND BD(5)=BD(8) THEN WN=BD(2):RETURN
4060 IF BD(3)<>0 AND BD(3)=BD(6) AND BD(6)=BD(9) THEN WN=BD(3):RETURN
4070 IF BD(1)<>0 AND BD(1)=BD(5) AND BD(5)=BD(9) THEN WN=BD(1):RETURN
4080 IF BD(3)<>0 AND BD(3)=BD(5) AND BD(5)=BD(7) THEN WN=BD(3):RETURN
4090 RETURN
4100 FL=1
4110 IF BD(1)=0 OR BD(2)=0 OR BD(3)=0 THEN FL=0
4120 IF BD(4)=0 OR BD(5)=0 OR BD(6)=0 THEN FL=0
4130 IF BD(7)=0 OR BD(8)=0 OR BD(9)=0 THEN FL=0
4140 RETURN
5000 PRINT:PRINT "THANK YOU FOR PLAYING, ";NM$;"."
5010 IF PC>50 THEN 5100
5020 ON RND(5) GOTO 5030,5040,5050,5060,5070
5030 PRINT "MY CIRCUITS ENJOYED THE EXERCISE.":GOTO 5200
5040 PRINT "A LITTLE PRACTICE MAY CONFUSE ME NEXT TIME.":GOTO 5200
5050 PRINT "DO NOT WORRY, ";NM$;". I AM ONLY A COMPUTER.":GOTO 5200
5060 PRINT "I THINK THE MOVE KEYS WON THIS ROUND.":GOTO 5200
5070 PRINT "YOU WERE VERY FRIENDLY TO LET ME WIN SO OFTEN.":GOTO 5200
5100 ON RND(5) GOTO 5110,5120,5130,5140,5150
5110 PRINT "YOU ARE A FORMIDABLE OPPONENT, ";NM$;"!":GOTO 5200
5120 PRINT "THAT WAS EXCELLENT PLAYING!":GOTO 5200
5130 PRINT "I WILL HAVE TO POLISH MY PROGRAM BEFORE WE MEET AGAIN.":GOTO 5200
5140 PRINT "YOU HAVE A REAL TALENT FOR THIS GAME.":GOTO 5200
5150 PRINT "MY COMPLIMENTS! YOU KEPT ME VERY BUSY.":GOTO 5200
5200 PRINT:PRINT "GOODBYE, ";NM$;"!"
5210 END
