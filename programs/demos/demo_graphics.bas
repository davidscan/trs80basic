10 CLS
20 FOR X=20 TO 80: SET(X,44): NEXT
30 FOR Y=28 TO 43: SET(34,Y): SET(35,Y): SET(65,Y): SET(66,Y): NEXT
40 FOR X=34 TO 66: SET(X,28): NEXT
50 FOR I=0 TO 16: SET(50-I,20+I/2): SET(50+I,20+I/2): NEXT
60 REM DOOR: POKE SOLID SEMIGRAPHICS INTO DISPLAY MEMORY
70 FOR R=12 TO 14: FOR C=24 TO 25: POKE 15360+R*64+C,191: NEXT C: NEXT R
80 REM WINDOW: PRINT@ WITH CHR$ SEMIGRAPHICS
90 PRINT @ 11*64+28, CHR$(191);CHR$(191);CHR$(191);
100 PRINT @ 0, "TRS-80 SEMIGRAPHICS HOUSE";
110 PRINT @ 64, "BALL BOUNCES - PRESS Q TO QUIT";
120 BX=10: BY=9: DX=1: DY=1
130 K$=INKEY$: IF K$="Q" OR K$="q" THEN 250
140 RESET(BX,BY)
150 BX=BX+DX: BY=BY+DY
160 IF BX<1 OR BX>126 THEN DX=-DX
170 IF BY<7 OR BY>18 THEN DY=-DY
180 IF POINT(BX+DX,BY+DY) THEN DX=-DX: DY=-DY
190 SET(BX,BY)
200 FOR D=1 TO 30: NEXT
210 GOTO 130
250 PRINT @ 896, "BYE FROM THE HOUSE DEMO";
260 END
