10 REM Level II converts to an integer by rounding DOWN (manual, CINT:
20 REM "CINT(1.5) returns 1; CINT(-1.5) returns -2"); AND, OR, NOT, CINT
30 REM and MKI$ all do.  Limits: -32768 <= x < 32768, else ?OV.
40 F=0:ON ERROR GOTO 900
50 V=156:IF (V/16 AND 15)<>9 THEN PRINT "FAIL: V/16 AND 15 =";V/16 AND 15:F=1
60 IF (2.7 AND 7)<>2 THEN PRINT "FAIL: 2.7 AND 7":F=1
70 IF (2.5 OR 1)<>3 THEN PRINT "FAIL: 2.5 OR 1":F=1
80 IF (NOT 1.5)<>-2 THEN PRINT "FAIL: NOT 1.5 =";NOT 1.5:F=1
90 IF CINT(1.5)<>1 OR CINT(-1.5)<>-2 THEN PRINT "FAIL: CINT(1.5), CINT(-1.5) =";CINT(1.5);CINT(-1.5):F=1
100 IF CINT(32767.7)<>32767 THEN PRINT "FAIL: CINT(32767.7)":F=1
110 IF CINT(-32768)<>-32768 THEN PRINT "FAIL: CINT(-32768)":F=1
120 S=1:X=CINT(32768)
130 IF S<>2 THEN PRINT "FAIL: CINT(32768) WAS NOT ?OV":F=1
140 S=3:X=CINT(-32768.5)
150 IF S<>4 THEN PRINT "FAIL: CINT(-32768.5) WAS NOT ?OV":F=1
160 S=0:IF CVI(MKI$(7.9))<>7 OR CVI(MKI$(-7.1))<>-8 THEN PRINT "FAIL: MKI$ DID NOT ROUND DOWN":F=1
170 REM the high-byte idiom the rule exists for: D-256*CINT(D/256) is 0-255
180 D=17407:C=CINT(D/256):IF C<>67 OR D-256*C<>255 THEN PRINT "FAIL: HIGH BYTE IDIOM";C;D-256*C:F=1
182 REM NOT where an operand is expected is the operator, at its own precedence (ROM 25C4H: 5AH), never a variable named NOT
184 IF (5+NOT 0)<>4 OR (5*NOT 0)<>-5 OR (-NOT 0)<>1 THEN PRINT "FAIL: NOT AFTER AN OPERATOR";5+NOT 0;5*NOT 0;-NOT 0:F=1
186 IF (5+NOT 0+1)<>3 OR (2^NOT 0)<>.5 OR (5+NOT 0=0)<>5 THEN PRINT "FAIL: NOT TAKES THE ARITHMETIC THAT FOLLOWS IT";5+NOT 0+1;2^NOT 0:F=1
190 ON ERROR GOTO 0:IF F THEN PRINT "INTCONV FIXTURE FAILED":ERROR 5
200 PRINT "INTCONV FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3) AND C=6 THEN S=S+1:RESUME NEXT
920 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
