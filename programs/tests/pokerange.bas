10 REM POKE's value and OUT's two arguments are bytes by the ROM's rule
20 REM (2B1C-2B22): outside 0-255 is ?FC and NOTHING is stored; outside
30 REM the integer range is ?OV.  255.9 rounds DOWN to 255 and is stored.
40 F=0:ON ERROR GOTO 900:CLS
50 POKE 15360,65
60 S=1:POKE 15360,256
70 IF S<>2 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,256  S=";S;PEEK(15360):F=1
80 S=3:POKE 15360,-1
90 IF S<>4 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,-1  S=";S;PEEK(15360):F=1
100 S=5:POKE 15360,70000
110 IF S<>6 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,70000  S=";S;PEEK(15360):F=1
120 S=0:POKE 15360,255.9
130 IF PEEK(15360)<>255 THEN PRINT "FAIL: POKE ,255.9 STORED";PEEK(15360):F=1
140 POKE 15360,0:IF PEEK(15360)<>0 THEN PRINT "FAIL: POKE ,0":F=1
150 S=7:OUT 255,256
160 IF S<>8 THEN PRINT "FAIL: OUT 255,256 WAS NOT ?FC":F=1
170 S=9:OUT 256,0
180 IF S<>10 THEN PRINT "FAIL: OUT 256,0 WAS NOT ?FC":F=1
190 S=0:OUT 255,8:IF INP(255)<>63 THEN PRINT "FAIL: OUT 255,8 DID NOT LATCH":F=1
200 OUT 255,0:CLS
210 ON ERROR GOTO 0:IF F THEN PRINT "POKERANGE FIXTURE FAILED":ERROR 5
220 PRINT "POKERANGE FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3 OR S=7 OR S=9) AND C=5 THEN S=S+1:RESUME NEXT
920 IF S=5 AND C=6 THEN S=6:RESUME NEXT
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
