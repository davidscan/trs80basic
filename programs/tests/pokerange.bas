10 REM POKE's value and OUT's two arguments are bytes by the ROM's rule
20 REM (2B1C-2B22): outside 0-255 is ?FC and NOTHING is stored; outside
30 REM the integer range is ?OV.  255.9 rounds DOWN to 255 and is stored.
40 F=0:ON ERROR GOTO 900:CLS
50 POKE 15360,65
60 S=1:POKE 15360,256
70 IF S<>2 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,256  S=";S;PEEK(15360):F=1
80 S=3:POKE 15360,-1
90 IF S<>4 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,-1  S=";S;PEEK(15360):F=1
100 S=5:POKE 15360,70000
110 IF S<>6 OR PEEK(15360)<>65 THEN PRINT "FAIL: POKE ,70000  S=";S;PEEK(15360):F=1
120 S=0:POKE 15360,255.9
130 IF PEEK(15360)<>255 THEN PRINT "FAIL: POKE ,255.9 STORED";PEEK(15360):F=1
140 POKE 15360,0:IF PEEK(15360)<>0 THEN PRINT "FAIL: POKE ,0":F=1
150 S=7:OUT 255,256
160 IF S<>8 THEN PRINT "FAIL: OUT 255,256 WAS NOT ?FC":F=1
170 S=9:OUT 256,0
180 IF S<>10 THEN PRINT "FAIL: OUT 256,0 WAS NOT ?FC":F=1
190 S=0:OUT 255,8:IF INP(255)<>63 THEN PRINT "FAIL: OUT 255,8 DID NOT LATCH":F=1
200 OUT 255,0:CLS
201 REM 0000-2FFFH is the ROM: a POKE there changes nothing (L-45); 3000H up is not ROM
202 S=0:A=PEEK(100):POKE 100,90:IF PEEK(100)<>A THEN PRINT "FAIL: A POKE INTO THE ROM READ BACK";PEEK(100):F=1
204 A=PEEK(12287):POKE 12287,90:IF PEEK(12287)<>A THEN PRINT "FAIL: A POKE AT 2FFFH READ BACK":F=1
206 POKE 12288,90:IF PEEK(12288)<>90 THEN PRINT "FAIL: 3000H IS NOT ROM":F=1
207 REM --- the address is the ROM's integer (2CAAH and 2B02H -> 0A7FH): ?OV outside -32768..32767,
208 REM nothing stored; a negative address is the top 32K (POKE -1 is 65535)
211 S=11:POKE 32768,7:IF S<>12 THEN PRINT "FAIL: POKE 32768 WAS NOT ?OV  S=";S:F=1
212 S=13:A=PEEK(32768):IF S<>14 THEN PRINT "FAIL: PEEK(32768) WAS NOT ?OV  S=";S:F=1
213 S=15:A=PEEK(-32769):IF S<>16 THEN PRINT "FAIL: PEEK(-32769) WAS NOT ?OV  S=";S:F=1
214 S=0:POKE 25536,65:S=17:POKE -40000,7:IF S<>18 OR PEEK(25536)<>65 THEN PRINT "FAIL: POKE -40000 WAS NOT ?OV, OR STORED  S=";S;PEEK(25536):F=1
215 S=0:POKE -1,9:POKE -32768,8:IF PEEK(-1)<>9 OR PEEK(-32768)<>8 THEN PRINT "FAIL: POKE -1 / -32768";PEEK(-1);PEEK(-32768):F=1
216 POKE -32768.5,7:IF PEEK(-32768)<>8 THEN PRINT "FAIL: -32768.5 ROUNDS DOWN TO -32769, ?OV":F=1
290 ON ERROR GOTO 0:IF F THEN PRINT "POKERANGE FIXTURE FAILED":ERROR 5
295 PRINT "POKERANGE FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3 OR S=7 OR S=9) AND C=5 THEN S=S+1:RESUME NEXT
920 IF (S=5 OR S=11 OR S=13 OR S=15 OR S=17) AND C=6 THEN S=S+1:RESUME NEXT
925 IF S=0 AND C=6 AND ERL=216 THEN RESUME NEXT
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
