10 REM THE SYSTEM VARIABLE WINDOW (p75 sv_*, built 2026-09-11): ROM RAM cells served from live state
20 REM self-checking batch fixture: TRS80_PRINTER=<file> ./basic programs/tests/sysvar.bas exits 1 on any mismatch
30 DIM Z(1):F=0
40 REM --- cursor position 4020/4021H reads 3C00H+CUR, and POKE moves the cursor
50 PRINT@70,"";:P=PEEK(16416)+256*PEEK(16417):IF P<>15430 THEN PRINT "FAIL cursor position";P:F=1
60 POKE 16416,200:POKE 16417,60:PRINT "HERE";:IF PEEK(15560)<>72 OR PEEK(15563)<>69 THEN PRINT "FAIL POKE moved the cursor";PEEK(15560):F=1
70 PRINT
80 REM --- cursor character 4022H: the ROM default, POKEable, 0 hides
90 IF PEEK(16418)<>176 THEN PRINT "FAIL cursor character default";PEEK(16418):F=1
100 POKE 16418,0:IF PEEK(16418)<>0 THEN PRINT "FAIL cursor character POKE":F=1
110 POKE 16418,176
120 REM --- printer: lines per page 4028H, line counter 4029H, column 409BH
130 IF PEEK(16424)<>67 THEN PRINT "FAIL lines per page";PEEK(16424):F=1
140 IF PEEK(16425)<>0 OR PEEK(16539)<>0 THEN PRINT "FAIL printer counters start at 0":F=1
150 LPRINT "ABC";:IF PEEK(16539)<>3 THEN PRINT "FAIL printer column";PEEK(16539):F=1
160 LPRINT:LPRINT "X":IF PEEK(16425)<>2 OR PEEK(16539)<>0 THEN PRINT "FAIL line counter";PEEK(16425);PEEK(16539):F=1
170 POKE 16425,1:IF PEEK(16425)<>1 THEN PRINT "FAIL POKE 16425,1 (new page idiom)":F=1
180 POKE 16424,11:FOR I=1 TO 9:LPRINT "L";I:NEXT:IF PEEK(16425)<>0 THEN PRINT "FAIL line counter wraps at lines per page - 1";PEEK(16425):F=1
190 POKE 16424,67:POKE 16425,0
200 REM --- the Model I clock 4041-4046H agrees with TIME$ (MM/DD/YY HH:MN:SS)
210 T$=TIME$:IF PEEK(16454)<>VAL(LEFT$(T$,2)) OR PEEK(16453)<>VAL(MID$(T$,4,2)) OR PEEK(16452)<>VAL(MID$(T$,7,2)) THEN PRINT "FAIL clock date";PEEK(16454);PEEK(16453);PEEK(16452);T$:F=1
220 IF PEEK(16451)<>VAL(MID$(T$,10,2)) THEN PRINT "FAIL clock hour";PEEK(16451);T$:F=1
230 REM --- the current line number 40A2/40A3H
240 IF PEEK(16546)+256*PEEK(16547)<>240 THEN PRINT "FAIL current line";PEEK(16546)+256*PEEK(16547):F=1
250 REM --- AUTO state 40E1-40E5H: readable, POKEable; the request itself fires at the READY prompt (t33)
260 IF PEEK(16609)<>0 OR PEEK(16612)+256*PEEK(16613)<>10 OR PEEK(16610)+256*PEEK(16611)<>10 THEN PRINT "FAIL AUTO defaults":F=1
270 POKE 16612,5:POKE 16613,0:POKE 16610,100:POKE 16611,0:IF PEEK(16612)<>5 OR PEEK(16610)<>100 THEN PRINT "FAIL AUTO POKEs":F=1
280 REM --- TRON flag 411BH: 175 on, 0 off, POKE switches it
290 IF PEEK(16667)<>0 THEN PRINT "FAIL TRON flag off":F=1
300 POKE 16667,1:IF PEEK(16667)<>175 THEN PRINT "FAIL TRON flag on";PEEK(16667):F=1
310 POKE 16667,0
320 IF PEEK(16667)<>0 THEN PRINT "FAIL TROFF by POKE":F=1
330 REM --- an ordinary system RAM cell next door is still plain memory
340 POKE 16419,99:IF PEEK(16419)<>99 THEN PRINT "FAIL neighbour cell":F=1
350 IF F THEN PRINT "SYSVAR FIXTURE FAILED":Z(9)=0
360 PRINT "SYSVAR FIXTURE OK"
