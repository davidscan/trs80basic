READY
>NEW
READY
>10 REM T23 KEYBOARD MATRIX (PEEK 14336-14591) + USR/DEF USR STUB
>20 P1=PEEK(14591)
>30 P2=PEEK(14591)
>40 PRINT "COMPOSITE";P1;P2
>50 P3=PEEK(14337)
>60 P4=PEEK(14464)
>70 PRINT "LOWER";P3;P4
>80 P5=PEEK(14400)
>90 P6=PEEK(14400)
>100 PRINT "SPACEROW";P5;P6
>110 P7=PEEK(14352)
>120 P8=PEEK(14336)
>130 PRINT "DIGIT";P7;P8
>140 POKE 14400,7
>150 P9=PEEK(14400)
>160 PRINT "POKEINV";P9
>165 PRINT "PRINTER";PEEK(14312)
>166 PRINT "DOSPROBE";PEEK(16396)
>167 POKE 16396,7:PRINT "DOSPOKE";PEEK(16396)
>168 POKE 16396,201:PRINT "DOSREST";PEEK(16396)
>170 DEFUSR=&H7D00
>180 DEF USR3=32000+2
>182 DEF USR 4=32000
>184 DEFUSR 5=&H7D00
>190 X=USR(42):Y=USR3(7):Z=USR0(X+1)
>195 W=USR4(1)+USR5(2)
>197 PRINT "USRSPACED";W
>198 V1=USR 0(11):V2=USR 4(12):V3=USR 3(13)
>199 PRINT "USRCALLSP";V1;V2;V3
>200 PRINT "USR";X;Y;Z
>210 ON ERROR GOTO 230
>220 E9=0:DEF USR=CHR$(65)
>225 GOTO 240
>230 E9=ERR/2+1:RESUME 240
>240 PRINT "DEFUSRTM";E9
>250 ON ERROR GOTO 270
>260 F9=0:DEF QQ=5
>265 GOTO 280
>270 F9=ERR/2+1:RESUME 280
>280 PRINT "DEFSN";F9
>290 END
>RUN
COMPOSITE 3  1 
LOWER 2  0 
SPACEROW 128  1 
DIGIT 32  0 
POKEINV 1 
PRINTER 63 
DOSPROBE 201 
DOSPOKE 7 
DOSREST 201 
USRSPACED 3 
USRCALLSP 11  12  13 
USR 42  7  43 
DEFUSRTM 13 
DEFSN 2 
READY
>BYE
exit=0
