10 REM A variable is its name AND its type: V, V%, V! and V# are four variables, A() and
20 REM A%() two arrays (the Level II manual, section 1: "A$, A%, A!, A# are distinct variable
30 REM names"; Farvour 2675H-2682H: the lookup compares the type byte, then both name characters,
40 REM of each entry).  A bare name takes its type from the DEF table at the
50 REM moment of the reference, so after DEFINT C a bare C is C%, a new variable; under
60 REM DEFSTR A a bare A is A$.  Until 2026-10-24 the type was not part of the name here.
70 F=0
100 T%=7:T=2.5:IF T%<>7 OR T<>2.5 THEN PRINT "FAIL: T% AND T SHARED A VALUE";T%;T:F=1
110 V%=1:IF V<>0 OR V!<>0 OR V#<>0 THEN PRINT "FAIL: V%=1 SET V, V! OR V#";V;V!;V#:F=1
120 L=1:L%=2:L!=3:L#=4:IF L<>3 OR L%<>2 OR L#<>4 THEN PRINT "FAIL: L L% L! L# GAVE";L;L%;L!;L#:F=1
130 H#=1/3:H=7:IF H<>7 OR H#>.34 THEN PRINT "FAIL: H=7 REWROTE H#";H#;H:F=1
140 C=2.5:DEFINT C:IF C<>0 OR C!<>2.5 THEN PRINT "FAIL: AFTER DEFINT C, C IS C%";C;C!:F=1
150 DEFSTR A:A="X":IF A$<>"X" THEN PRINT "FAIL: UNDER DEFSTR A, A IS A$";A$:F=1
160 DEFSTR B:B="S":B%=3:IF B<>"S" OR B%<>3 THEN PRINT "FAIL: UNDER DEFSTR B, B AND B%";B;B%:F=1
170 N=0:FOR I=1 TO 2:I%=9:N=N+1:NEXT:IF N<>2 THEN PRINT "FAIL: I%=9 MOVED THE INDEX I";N:F=1
180 DIM D(2):DIM D%(2):D(1)=1:D%(1)=2:IF D(1)<>1 OR D%(1)<>2 THEN PRINT "FAIL: D() AND D%()";D(1);D%(1):F=1
190 DIM G(2):G(1)=5:DEFINT G:IF G(1)<>0 THEN PRINT "FAIL: AFTER DEFINT G, G() IS G%()";G(1):F=1
200 DEFSTR K:DIM K(2):K$(1)="Q":IF K(1)<>"Q" THEN PRINT "FAIL: UNDER DEFSTR K, K() IS K$()";K(1):F=1
210 E=1:E%=2:IF VARPTR(E)=VARPTR(E%) THEN PRINT "FAIL: E AND E% HAVE ONE VARPTR":F=1
220 READ M%,M:IF M%<>1 OR M<>2.5 THEN PRINT "FAIL: READ M%,M GAVE";M%;M:F=1
230 DATA 1.5,2.5
240 ON ERROR GOTO 400
250 S=1:FOR J%=1 TO 2:NEXT J:PRINT "FAIL: NEXT J CLOSED FOR J%":F=1
252 REM VARPTR of a simple variable never stored is ?FC (Farvour 24F5H-24F7H); an element is not
253 S=3:W%=1:DEFDBL W:X=VARPTR(W):PRINT "FAIL: VARPTR OF THE NEVER-STORED W# GAVE";X:F=1
254 S=5:X=VARPTR(Z6$):PRINT "FAIL: VARPTR OF THE NEVER-STORED Z6$ GAVE";X:F=1
256 S=7:X=VARPTR(Z7(1)):IF X=0 THEN PRINT "FAIL: VARPTR(Z7(1)) GAVE 0":F=1
260 ON ERROR GOTO 0
270 IF F THEN PRINT "SUFFIXID FIXTURE FAILED":ERROR 5
280 PRINT "SUFFIXID FIXTURE OK":END
400 IF S=1 AND ERR/2+1=1 AND ERL=250 THEN S=2:RESUME 253
402 IF S=3 AND ERR/2+1=5 AND ERL=253 THEN S=4:RESUME 254
404 IF S=5 AND ERR/2+1=5 AND ERL=254 THEN S=6:RESUME 256
410 PRINT "FAIL: UNEXPECTED ERROR";ERR/2+1;"IN";ERL:F=1:RESUME 260
