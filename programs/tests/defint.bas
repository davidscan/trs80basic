10 REM A number stored into an INTEGER variable is rounded DOWN: LET goes
20 REM through 2819H to 0A7FH (CINT) for an integer target.  An integer
30 REM name is one in DEFINT's range or one written with %; ! and #
40 REM override DEFINT.  FOR with an integer index rounds its start, TO
50 REM (1CD7H) and STEP (2B01H) the same way.
55 REM CLEAR resets the type table, as RUN does (and wipes F, so it goes first)
60 DEFINT M:CLEAR 50:F=0:M=7.5:IF M<>7.5 THEN PRINT "FAIL: CLEAR DID NOT RESET DEFINT";M:F=1
65 DIM K(3)
70 DEFINT I-N
80 I=7/2:IF I<>3 THEN PRINT "FAIL: DEFINT I=7/2 GAVE";I:F=1
90 J=-2.5:IF J<>-3 THEN PRINT "FAIL: DEFINT J=-2.5 GAVE";J:F=1
100 A%=9.9:IF A%<>9 THEN PRINT "FAIL: A%=9.9 GAVE";A%:F=1
110 B=1.5:IF B<>1.5 THEN PRINT "FAIL: B=1.5 (SINGLE) GAVE";B:F=1
120 L!=2.5:IF L<>2.5 THEN PRINT "FAIL: L!=2.5 UNDER DEFINT GAVE";L:F=1
130 K(1)=5.7:IF K(1)<>5 THEN PRINT "FAIL: DEFINT ARRAY K(1)=5.7 GAVE";K(1):F=1
140 READ M,N%,Q:IF M<>3 OR N%<>-2 OR Q<>3.7 THEN PRINT "FAIL: READ GAVE";M;N%;Q:F=1
150 C=0:FOR N=1.5 TO 3.9:C=C+1:NEXT:IF C<>3 OR N<>4 THEN PRINT "FAIL: FOR N=1.5 TO 3.9 RAN";C;"TIMES, N=";N:F=1
160 C=0:FOR N=1 TO 4 STEP 1.9:C=C+1:NEXT:IF C<>4 THEN PRINT "FAIL: STEP 1.9 ON AN INTEGER INDEX RAN";C;"TIMES":F=1
170 DEFSNG I:I=7/2:IF I<>3.5 THEN PRINT "FAIL: DEFSNG DID NOT CLEAR DEFINT";I:F=1
180 DEFSTR J:J="X":DEFINT J:J=7.5:IF J<>7 THEN PRINT "FAIL: DEFINT AFTER DEFSTR";J:F=1
200 REM a value past -32768..32767 is kept for now (?OV is a separate ruling)
210 DEFINT X:X=40000.5:IF X<>40000.5 THEN PRINT "FAIL: OUT OF RANGE STORE CHANGED";X:F=1
220 IF F THEN PRINT "DEFINT FIXTURE FAILED":ERROR 5
230 PRINT "DEFINT FIXTURE OK":END
240 DATA 3.7,-1.2,3.7
