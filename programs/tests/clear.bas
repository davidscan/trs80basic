10 REM CLEAR is RUN's initializer without the jump (ROM 1E7A/1EA0 -> 1B61):
20 REM the type table, RESTORE, ON ERROR, the stacks.  ERR/ERL survive.
25 REM the failure flag lives in a POKEd cell: CLEAR would zero a variable
30 POKE 32700,0:ON ERROR GOTO 900
40 REM --- the type table: DEFSTR before CLEAR is undone, after it holds
50 DEFSTR A:A="X":CLEAR 50:ON ERROR GOTO 900
60 S=1:A="Y"
70 IF S<>2 THEN PRINT "FAIL: DEFSTR SURVIVED CLEAR":POKE 32700,1
80 DEFSTR A:S=3:A="Z"
90 IF S<>3 OR A<>"Z" THEN PRINT "FAIL: DEFSTR AFTER CLEAR":POKE 32700,1
100 REM --- RESTORE: the DATA pointer goes back to the first item
110 READ N1,N2:CLEAR:ON ERROR GOTO 900:READ N3
120 IF N3<>11 THEN PRINT "FAIL: CLEAR DID NOT RESTORE, READ";N3:POKE 32700,1
130 REM --- a handler re-armed after CLEAR traps again (that CLEAR DISARMS
140 REM     it needs a fatal error to show: clear.sh does that)
150 S=4:Q=1/0
160 IF S<>5 THEN PRINT "FAIL: HANDLER NOT ARMED BEFORE THE TEST":POKE 32700,1
170 REM --- the stacks: a RETURN after CLEAR inside a subroutine is ?RG
180 S=6:GOSUB 800
190 IF S<>7 THEN PRINT "FAIL: RETURN AFTER CLEAR WAS NOT ?RG, S=";S:POKE 32700,1
200 ON ERROR GOTO 0:IF PEEK(32700) THEN PRINT "CLEAR FIXTURE FAILED":ERROR 5
210 PRINT "CLEAR FIXTURE OK":END
800 CLEAR:ON ERROR GOTO 900:S=6:RETURN
810 S=99:GOTO 190
900 REM handler: S says which probe raised it
910 IF S=1 AND ERR/2+1=13 THEN S=2:RESUME NEXT
920 IF S=4 AND ERR/2+1=11 THEN S=5:RESUME NEXT
930 IF S=6 AND ERR/2+1=3 THEN S=7:RESUME 190
940 PRINT "FAIL: UNEXPECTED ERROR";ERR/2+1;"IN";ERL;"S=";S:POKE 32700,1:RESUME 200
950 DATA 11,22,33
