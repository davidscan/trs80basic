10 REM dataerr.bas -- the data statements' errors, each at the ROM's own
20 REM point (the 2026-09-26 audit, fix-order step 8).  Self-checking:
30 REM a mismatch prints FAIL and the run ends in ERROR 5.
40 F=0:ON ERROR GOTO 900
100 REM M-3: FOR with a DOUBLE index.  LET stores the start (1CA6H), the
110 REM TO token is tested (1CC5H), then the index's type: ?TM (1CCBH)
120 S=1:FOR D#=5 TO 6
130 IF S<>2 THEN PRINT "FAIL: FOR D#=5 TO 6 WAS NOT ?TM  S=";S:F=1
140 IF D#<>5 THEN PRINT "FAIL: FOR D#=5 DID NOT STORE 5 BEFORE ?TM ";D#:F=1
150 DEFDBL Q:S=3:FOR Q=1 TO 2
160 IF S<>4 THEN PRINT "FAIL: FOR Q= UNDER DEFDBL Q WAS NOT ?TM  S=";S:F=1
170 S=5:FOR E#=1 X
180 IF S<>6 THEN PRINT "FAIL: FOR E#=1 X WAS NOT ?SN (TO IS TESTED FIRST)  S=";S:F=1
190 FOR G!=1 TO 2:NEXT:FOR H%=1 TO 2:NEXT:IF G!<>3 OR H%<>3 THEN PRINT "FAIL: A SINGLE OR INTEGER INDEX";G!;H%:F=1
200 REM L-1: a keyword is never a variable name: its byte is no letter to
210 REM the ROM's name reader (2612H-2615H), so each of these is ?SN
220 S=7:ABS=3
230 IF S<>8 THEN PRINT "FAIL: ABS=3 WAS NOT ?SN  S=";S:F=1
240 S=9:READ ERR
250 IF S<>10 THEN PRINT "FAIL: READ ERR WAS NOT ?SN  S=";S:F=1
260 S=11:DIM SIN(5)
270 IF S<>12 THEN PRINT "FAIL: DIM SIN(5) WAS NOT ?SN  S=";S:F=1
280 S=13:FOR STEP=1 TO 2
290 IF S<>14 THEN PRINT "FAIL: FOR STEP=1 WAS NOT ?SN  S=";S:F=1
300 S=15:LET PRINT=1
310 IF S<>16 THEN PRINT "FAIL: LET PRINT=1 WAS NOT ?SN  S=";S:F=1
320 S=17:V=VARPTR(TO)
330 IF S<>18 THEN PRINT "FAIL: VARPTR(TO) WAS NOT ?SN  S=";S:F=1
800 ON ERROR GOTO 0:IF F THEN PRINT "DATAERR FIXTURE FAILED":ERROR 5
810 PRINT "DATAERR FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3) AND C=13 THEN S=S+1:RESUME NEXT
920 IF S=5 AND C=2 THEN S=6:RESUME NEXT
930 IF (S=7 OR S=9 OR S=11 OR S=13 OR S=15 OR S=17) AND C=2 THEN S=S+1:RESUME NEXT
990 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
