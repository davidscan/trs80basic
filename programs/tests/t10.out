MEM SIZE? 

R/S L2 BASIC
------------------------------
TRS-80 LEVEL II BASIC emulator
 Codeveloped with Claude, 2026
------------------------------
man pages available for all BASIC commands
"help meta" to display supported metacommands
READY
>10 OPEN "O",1,"TSEQ.TXT"
>20 PRINT #1, "ALPHA"; ","; 42
>30 PRINT #1, "SECOND LINE, WITH COMMA"
>40 PRINT #1, "A";
>50 PRINT #1, "B"; TAB(6); "C"
>60 CLOSE 1
>70 OPEN "E",1,"TSEQ.TXT"
>80 PRINT #1, "APPENDED"
>90 CLOSE
>100 OPEN "I",2,"TSEQ.TXT"
>110 INPUT #2, A$, N
>120 PRINT "ITEMS: [";A$;"]";N
>130 LINE INPUT #2, L$
>140 PRINT "LINE1: [";L$;"]"
>150 IF EOF(2) THEN 190
>160 LINE INPUT #2, L$
>170 PRINT "MORE: [";L$;"]"
>180 GOTO 150
>190 PRINT "LOC=";LOC(2);"EOF=";EOF(2)
>200 CLOSE #2
>210 LINE INPUT "TYPE A LINE: "; K$
>220 PRINT "KEYED: [";K$;"]"
>230 KILL "TSEQ.TXT"
>240 END
>RUN
ITEMS: [ALPHA] 42 
LINE1: [SECOND LINE, WITH COMMA]
MORE: [AB    C]
MORE: [APPENDED]
LOC= 4 EOF=-1 
TYPE A LINE: HELLO, "QUOTED" WORLD
KEYED: [HELLO, "QUOTED" WORLD]
READY
>OPEN "I",1,"TSEQ.TXT"
?FF ERROR
READY
>CLOSE
READY
>BYE
exit=0
