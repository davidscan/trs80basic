10 REM A DOUBLE IS A SINGLE FIRST on its way to a BYTE, too: 2B1CH takes the integer through
20 REM 2B05H -> 0A7FH, CINT's own conversion, which calls CSNG's tail for a double (0A87H ->
30 REM 0AB9H, rounding at 0796H) before it drops the fraction.  So 28.9999999# is 29 for CHR$,
40 REM STRING$, LEFT$/RIGHT$/MID$, POKE, TAB, ON, ERROR and SET/RESET/POINT, as CINT gives it,
50 REM 255.99999999# is ?FC and 32767.9999999# is ?OV.  Until 2026-10-04 the byte converter
60 REM floored the raw double: 28 (the 2026-09-30 audit, BM-2; L-8 fixed CINT's other copies).
70 CLEAR 500:F=0:S=0:ON ERROR GOTO 900
80 A#=28.9999999#:B#=1.99999999#:C#=2.99999999#:D#=4.99999999#
100 IF CINT(A#)<>29 THEN PRINT "FAIL: CINT(28.9999999#) is 29:";CINT(A#):F=1
110 IF ASC(CHR$(A#+36))<>65 OR ASC(STRING$(2,A#+36))<>65 THEN PRINT "FAIL: CHR$, STRING$'s character:";ASC(CHR$(A#+36));ASC(STRING$(2,A#+36)):F=1
120 IF LEN(STRING$(A#,65))<>29 THEN PRINT "FAIL: STRING$'s count:";LEN(STRING$(A#,65)):F=1
130 X$=STRING$(40,65):IF LEN(LEFT$(X$,A#))<>29 OR LEN(RIGHT$(X$,A#))<>29 THEN PRINT "FAIL: LEFT$, RIGHT$:";LEN(LEFT$(X$,A#));LEN(RIGHT$(X$,A#)):F=1
140 X$="ABCD":IF MID$(X$,C#,1)<>"C" OR LEN(MID$(X$,1,C#))<>3 THEN PRINT "FAIL: MID$:";MID$(X$,C#,1);LEN(MID$(X$,1,C#)):F=1
150 POKE 20000,C#:IF PEEK(20000)<>3 THEN PRINT "FAIL: POKE's value:";PEEK(20000):F=1
160 PRINT TAB(C#);:IF POS(0)<>3 THEN PRINT:PRINT "FAIL: TAB:";POS(0):F=1
170 PRINT
180 N=0:ON B# GOSUB 960,970:IF N<>2 THEN PRINT "FAIL: ON 1.99999999# took branch";N:F=1
190 SET(C#,C#):IF POINT(3,3)<>-1 OR POINT(C#,C#)<>-1 THEN PRINT "FAIL: SET, POINT":F=1
200 RESET(C#,C#):IF POINT(3,3)<>0 THEN PRINT "FAIL: RESET":F=1
210 S=1:ERROR D#
220 S=3:A$=CHR$(255.99999999#)
230 S=5:POKE 20000,32767.9999999#
240 IF S<>6 THEN PRINT "FAIL: an error was missed, S=";S:F=1
250 IF ASC(CHR$(255.9999#))<>255 OR LEN(STRING$(2.5#,65))<>2 THEN PRINT "FAIL: a fraction a single keeps is still dropped":F=1
890 ON ERROR GOTO 0:IF F THEN PRINT "BYTEDBL FIXTURE FAILED":ERROR 5
895 PRINT "BYTEDBL FIXTURE OK":END
900 C=ERR/2+1
910 IF S=1 AND C=5 THEN S=2:RESUME NEXT
920 IF S=3 AND C=5 THEN S=4:RESUME NEXT
930 IF S=5 AND C=6 THEN S=6:RESUME NEXT
940 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
960 N=1:RETURN
970 N=2:RETURN
