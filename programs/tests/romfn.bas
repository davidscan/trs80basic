10 REM LOG, EXP, SQR AND ^ ARE THE ROM'S ROUTINES, in single precision (0809H-0846H, 13E7H-1478H):
20 REM LOG takes the exponent off and runs a three-term series on the mantissa; EXP scales a
30 REM polynomial in (INT(x/ln 2)+1)*ln 2 - x by a power of two; x^y is EXP(y*LOG(x)) and SQR(x)
40 REM is x^.5.  So a power is not exact where its factors are: 3^2 is 9.000003 and SQR(25) is
50 REM 5.000001, while 2^2 and SQR(4) come out whole -- and IF SQR(N)=INT(SQR(N)) answers as it
60 REM did on the machine.  Until 2026-10-05 these were the host's library, rounded.
70 CLEAR 500:F=0:S=0:ON ERROR GOTO 900
100 IF SQR(4)<>2 OR SQR(9)<>3 OR SQR(16)<>4 OR SQR(36)<>6 OR SQR(64)<>8 OR SQR(144)<>12 THEN PRINT "FAIL: SQR of 4 9 16 36 64 144 is whole":F=1
110 IF SQR(25)=5 OR SQR(49)=7 OR SQR(81)=9 OR SQR(100)=10 THEN PRINT "FAIL: SQR of 25 49 81 100 is not whole":F=1
120 IF 2^2<>4 OR 2^3<>8 OR 2^10<>1024 OR 4^2<>16 OR 8^2<>64 THEN PRINT "FAIL: 2^2 2^3 2^10 4^2 8^2 are whole":F=1
130 IF 3^2=9 OR 10^2=100 OR 5^3=125 OR 6^2=36 THEN PRINT "FAIL: 3^2 10^2 5^3 6^2 are not whole":F=1
140 IF INT(SQR(25))<>5 OR INT(SQR(24.9999))<>4 OR INT(10^2)<>100 OR INT(3^2)<>9 OR INT(7^2)<>49 OR INT(5^3)<>125 THEN PRINT "FAIL: INT of a power":F=1
150 D#=3^2:IF STR$(D#)<>" 9.000002861022949" THEN PRINT "FAIL: 3^2 as a double:";D#:F=1
160 D#=SQR(2):E#=2#^.5#:IF STR$(D#)<>" 1.414213538169861" OR D#<>E# THEN PRINT "FAIL: SQR(2), 2#^.5# (single):";D#;E#:F=1
170 D#=LOG(10):E#=EXP(1):IF STR$(D#)<>" 2.302585124969482" OR STR$(E#)<>" 2.718281984329224" THEN PRINT "FAIL: LOG(10), EXP(1):";D#;E#:F=1
180 D#=LOG(.99999994):IF STR$(D#)<>" 8.262958317573066D-08" THEN PRINT "FAIL: LOG(.99999994) (the ROM bug list's LOG entry):";D#:F=1
190 IF LOG(1)<>0 OR EXP(0)<>1 OR 1^5<>1 OR STR$(LOG(2))<>" .693147" THEN PRINT "FAIL: LOG(1) EXP(0) 1^5 LOG(2):";LOG(1);EXP(0);1^5;LOG(2):F=1
200 IF 0^0<>1 OR 5^0<>1 OR (-5)^0<>1 OR 0^2<>0 OR 0^.5<>0 OR SQR(0)<>0 THEN PRINT "FAIL: zero as base or exponent":F=1
210 IF (-8)^3<>-512 OR (-2)^2<>4 OR (-2)^-3<>-.125 OR (-2)^5<>-32 OR 2^-1<>.5 THEN PRINT "FAIL: a negative base, a whole exponent:";(-8)^3;(-2)^2;(-2)^-3;(-2)^5:F=1
220 REM odd or even is read off one byte of the exponent (0B40H): 1E10's mantissa is odd
230 IF (-1)^1E10<>-1 OR (-1)^2E10<>-1 OR (-1)^16777216<>1 OR (-1)^8388609<>-1 OR (-1)^3E10<>1 THEN PRINT "FAIL: the sign of a negative base to a large exponent":F=1
240 IF STR$(EXP(87.3365))<>" 8.50667E+37" OR EXP(-88.8)<>0 OR EXP(-200)<>0 OR STR$(EXP(-88.7))<>" 3.00664E-39" THEN PRINT "FAIL: EXP at its ends:";EXP(87.3365);EXP(-88.7):F=1
250 IF STR$(SQR(1E38))<>" 1E+19" OR STR$(SQR(1E-38))<>" 1E-19" OR STR$(1E-30^2)<>" 0" THEN PRINT "FAIL: SQR(1E38) SQR(1E-38) 1E-30^2:";SQR(1E38);SQR(1E-38);1E-30^2:F=1
260 I%=3:J%=2:IF I%^J%=9 THEN PRINT "FAIL: an integer power is single too":F=1
300 REM the errors: each line must raise the one named
310 S=1:C=11:X=0^-1
315 IF S<>-1 THEN PRINT "FAIL: STEP 1 RAISED NOTHING":F=1
320 S=2:C=5:X=(-8)^.333333
325 IF S<>-2 THEN PRINT "FAIL: STEP 2 RAISED NOTHING":F=1
330 S=3:C=5:X=(-2)^.5
335 IF S<>-3 THEN PRINT "FAIL: STEP 3 RAISED NOTHING":F=1
340 S=4:C=6:X=EXP(88)
345 IF S<>-4 THEN PRINT "FAIL: STEP 4 RAISED NOTHING":F=1
350 S=5:C=5:X=LOG(0)
355 IF S<>-5 THEN PRINT "FAIL: STEP 5 RAISED NOTHING":F=1
360 S=6:C=5:X=LOG(-1)
365 IF S<>-6 THEN PRINT "FAIL: STEP 6 RAISED NOTHING":F=1
370 S=7:C=5:X=SQR(-1)
375 IF S<>-7 THEN PRINT "FAIL: STEP 7 RAISED NOTHING":F=1
380 S=8:C=6:X=10^38
385 IF S<>-8 THEN PRINT "FAIL: STEP 8 RAISED NOTHING":F=1
390 S=9:C=6:X=2^127
395 IF S<>-9 THEN PRINT "FAIL: STEP 9 RAISED NOTHING":F=1
400 S=10:C=6:X=2^126
405 IF S<>-10 THEN PRINT "FAIL: STEP 10 RAISED NOTHING":F=1
410 S=11:C=6:X=1E20^2
415 IF S<>-11 THEN PRINT "FAIL: STEP 11 RAISED NOTHING":F=1
420 S=0
890 ON ERROR GOTO 0:IF F THEN PRINT "ROMFN FIXTURE FAILED":ERROR 5
895 PRINT "ROMFN FIXTURE OK":END
900 G=ERR/2+1:IF S=0 THEN PRINT "FAIL: UNEXPECTED ERROR";G;"IN";ERL:F=1:RESUME NEXT
910 IF G<>C THEN PRINT "FAIL: STEP";S;"RAISED";G;"NOT";C:F=1
920 S=-S:RESUME NEXT
