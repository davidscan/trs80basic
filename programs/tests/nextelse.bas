10 REM NEXT READS ITS INDEX ONLY WHEN THE STATEMENT GOES ON (22B6H CALL NZ,260DH), and the
20 REM reader refuses anything but a name (2612H): IF c THEN NEXT ELSE ... is a bare NEXT (the
30 REM ELSE is stored behind a ":", 1C42H), and NEXT TO, NEXT 5, NEXT ,I are ?SN before the loop
40 REM steps.  Until 2026-10-04 any identifier was the index, ELSE included: ?NF (the 2026-09-30
50 REM audit, BM-1).
60 F=0:S=0:ON ERROR GOTO 900
100 N=0:FOR I=1 TO 3:N=N+1:IF I<3 THEN NEXT ELSE N=N+10
110 IF N<>13 OR I<>3 THEN PRINT "FAIL: IF ... THEN NEXT ELSE:";N;I:F=1
120 N=0:FOR I=1 TO 2:N=N+1:IF I<2 THEN NEXT I ELSE NEXT:N=N+10
130 IF N<>12 THEN PRINT "FAIL: NEXT I ELSE NEXT:";N:F=1
140 N=0:FOR I=1 TO 2:FOR J=1 TO 2:N=N+1:NEXT J,I:IF N<>4 THEN PRINT "FAIL: NEXT J,I:";N:F=1
200 N=0:FOR I=1 TO 2:N=N+1:S=1:NEXT TO
210 IF S<>2 OR N<>1 THEN PRINT "FAIL: NEXT TO is ?SN at once:";S;N:F=1
220 N=0:FOR I=1 TO 2:N=N+1:S=3:NEXT 5
230 IF S<>4 OR N<>1 THEN PRINT "FAIL: NEXT 5 is ?SN at once:";S;N:F=1
240 N=0:FOR I=1 TO 2:N=N+1:S=5:NEXT ,I
250 IF S<>6 OR N<>1 THEN PRINT "FAIL: NEXT ,I is ?SN at once:";S;N:F=1
890 ON ERROR GOTO 0:IF F THEN PRINT "NEXTELSE FIXTURE FAILED":ERROR 5
895 PRINT "NEXTELSE FIXTURE OK":END
900 C=ERR/2+1
910 IF S=1 AND C=2 THEN S=2:RESUME 210
915 IF S=3 AND C=2 THEN S=4:RESUME 230
920 IF S=5 AND C=2 THEN S=6:RESUME 250
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME 890
