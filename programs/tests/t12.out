READY
>10 ON ERROR GOTO 500
>20 INPUT #3, A$
>30 OPEN "O",1,"TERR.TXT": OPEN "O",1,"TERR2.TXT"
>40 OPEN "I",2,"NOSUCH.FIL"
>50 OPEN "I",2,"TERR.TXT"
>60 PRINT #1, "DATA": CLOSE 1
>70 OPEN "I",2,"TERR.TXT"
>80 PRINT #2, "Y"
>90 INPUT #2, B$: INPUT #2, B$
>95 X = LOF(2)
>100 OPEN "O",16,"TBAD.TXT"
>110 OPEN "X",4,"TBAD.TXT"
>120 OPEN "R",3,"TR.DAT",24
>130 FIELD 3, 300 AS Z$
>140 GET 3, 0
>150 GET 3, 1
>170 CLOSE
>180 KILL "NOSUCH.FIL"
>190 KILL "TERR.TXT": KILL "TR.DAT"
>200 ERROR 27
>210 END
>500 PRINT "ERR CODE";ERR/2+1;"IN";ERL: RESUME NEXT
>RUN
