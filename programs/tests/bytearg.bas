10 REM A BYTE ARGUMENT goes through 2B1CH: the 16-bit conversion first (2B05H -> 0A7FH, ?OV
20 REM outside -32768..32767), then ?FC when the high byte is not zero (2B22H: negative or
30 REM past 255).  CHR$, STRING$ (both arguments), INP, TAB, LPRINT TAB, ON n, SET, RESET and
40 REM POINT take theirs that way; PRINT @ takes a 16-bit integer (2B01H) and is ?FC past 1023
50 REM (208DH).  SET/RESET/POINT test x against 128 as soon as it is read, before y (0140H).
60 REM Until 2026-09-27 every one of them was ?FC (the 2026-09-26 audit, L-7).
70 F=0:S=0:ON ERROR GOTO 900
100 S=1:A$=CHR$(40000)
110 S=3:A$=CHR$(256)
120 S=5:A$=CHR$(-1)
130 S=7:A$=STRING$(40000,"A")
140 S=9:A$=STRING$(3,40000)
150 S=11:A$=STRING$(3,256)
160 S=13:X=INP(40000)
170 S=15:X=INP(-32769)
180 S=17:PRINT TAB(40000);
190 S=19:PRINT TAB(256);
200 S=21:PRINT @40000,"X";
210 S=23:PRINT @1024,"X";
220 S=25:PRINT @-1,"X";
230 S=27:SET(40000,0)
240 S=29:SET(128,0)
250 S=31:SET(0,48)
260 S=33:RESET(200,1/0)
270 S=35:X=POINT(40000,0)
280 S=37:X=POINT(0,48)
290 S=39:ON 40000 GOTO 300
295 S=41:ON -1 GOTO 300
300 S=43:ON 256 GOTO 310
310 IF S<>44 THEN PRINT "FAIL: an error was missed, S=";S:F=1
320 IF CHR$(65.9)<>"A" OR CHR$(255.5)<>CHR$(255) OR LEN(STRING$(255.9,"A"))<>255 THEN PRINT "FAIL: the fraction is dropped (0A7FH rounds down)":F=1
330 SET(127,47):IF POINT(127,47)<>-1 THEN PRINT "FAIL: SET(127,47)":F=1
340 RESET(127,47):IF POINT(127,47)<>0 THEN PRINT "FAIL: RESET(127,47)":F=1
350 ON 0 GOTO 360:ON 255 GOTO 360
360 PRINT @1023,"";
890 ON ERROR GOTO 0:IF F THEN PRINT "BYTEARG FIXTURE FAILED":ERROR 5
895 PRINT "BYTEARG FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=7 OR S=9 OR S=13 OR S=15 OR S=17 OR S=21 OR S=27 OR S=35 OR S=39) AND C=6 THEN S=S+1:RESUME NEXT
920 IF (S=3 OR S=5 OR S=11 OR S=19 OR S=23 OR S=25 OR S=29 OR S=31 OR S=37 OR S=41 OR S=43) AND C=5 THEN S=S+1:RESUME NEXT
925 IF S=33 AND C=5 THEN S=34:RESUME NEXT
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
