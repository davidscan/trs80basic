10 REM Control flow the suite did not pin (the 2026-09-23 audit, M-13):
20 REM ON n GOSUB/GOTO, NEXT J,I, a negative STEP, a loop body runs at
30 REM least once (FOR at 1CA1H only builds the frame; the compare is
40 REM NEXT's, at 2310H), RESUME's forms, DEF FN's parameter, RESTORE n.
50 F=0:ON ERROR GOTO 900
60 REM --- ON n GOSUB: 0 and a value past the list fall through; ON n GOTO
70 N$="":ON 2 GOSUB 500,510,520:N$=N$+"B"
80 ON 0 GOSUB 500:ON 4 GOSUB 500,510,520:N$=N$+"F"
90 ON 3 GOTO 600,610,620
100 N$=N$+"?"
110 IF N$<>"2BFZ" THEN PRINT "FAIL: ON GOSUB/GOTO ";N$:F=1
120 REM --- FOR/NEXT: NEXT J,I closes both, STEP -1 makes every pass and
130 REM     leaves the index past the limit, STEP .5, the body runs once
140 N$="":FOR I=1 TO 2:FOR J=1 TO 2:N$=N$+CHR$(48+I)+CHR$(48+J):NEXT J,I
150 IF N$<>"11122122" THEN PRINT "FAIL: NEXT J,I ";N$:F=1
160 N$="":FOR K=3 TO 1 STEP -1:N$=N$+CHR$(48+K):NEXT
170 IF N$<>"321" OR K<>0 THEN PRINT "FAIL: STEP -1 ";N$;K:F=1
180 N=0:FOR X=1 TO 2 STEP .5:N=N+1:NEXT:IF N<>3 OR X<>2.5 THEN PRINT "FAIL: STEP .5";N;X:F=1
190 N=0:FOR I=5 TO 1:N=N+1:NEXT:IF N<>1 OR I<>6 THEN PRINT "FAIL: A LOOP BODY RUNS ONCE";N;I:F=1
200 REM --- RESUME: bare RESUME and RESUME 0 retry the failed statement,
210 REM     RESUME NEXT goes to the statement after it, not the next line
220 S=1:D=0
230 X=10/D:IF X<>5 THEN PRINT "FAIL: BARE RESUME, X=";X:F=1
240 S=2:E=0
250 Y=5/E:IF Y<>1 THEN PRINT "FAIL: RESUME 0, Y=";Y:F=1
260 S=3:G=0:N$="":Z=1/G:N$=N$+"N":N$=N$+"X"
270 IF N$<>"NX" OR S<>4 THEN PRINT "FAIL: RESUME NEXT ";N$;S:F=1
280 REM --- DEF FN: the parameter is restored, and may appear in the argument
290 DEF FNA(X)=X*2:X=5:Y=FNA(3):Z=FNA(X+1)
300 IF X<>5 OR Y<>6 OR Z<>12 THEN PRINT "FAIL: DEF FN";X;Y;Z:F=1
310 REM --- RESTORE n (Disk BASIC) starts at line n's own DATA; RESTORE at the first
320 RESTORE 810:READ R:RESTORE:READ R0
330 IF R<>42 OR R0<>1 THEN PRINT "FAIL: RESTORE";R;R0:F=1
340 REM --- READ past the last item is ?OD
350 RESTORE 810:READ R:S=5:READ Q
360 IF S<>6 THEN PRINT "FAIL: READ PAST THE END WAS NOT ?OD  S=";S:F=1
370 ON ERROR GOTO 0:IF F THEN PRINT "CONTROLFLOW FIXTURE FAILED":ERROR 5
380 PRINT "CONTROLFLOW FIXTURE OK":END
500 N$=N$+"1":RETURN
510 N$=N$+"2":RETURN
520 N$=N$+"3":RETURN
600 N$=N$+"X":GOTO 110
610 N$=N$+"Y":GOTO 110
620 N$=N$+"Z":GOTO 110
800 DATA 1
810 DATA 42
900 C=ERR/2+1
910 IF S=1 AND C=11 AND ERL=230 THEN S=0:D=2:RESUME
920 IF S=2 AND C=11 AND ERL=250 THEN S=0:E=5:RESUME 0
930 IF S=3 AND C=11 AND ERL=260 THEN S=4:RESUME NEXT
940 IF S=5 AND C=4 AND ERL=350 THEN S=6:RESUME NEXT
950 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
