READY
>10 OPEN "R",1,"TRND.DAT",24
>20 FIELD 1, 10 AS N$, 2 AS I$, 4 AS S$, 8 AS D$
>30 LSET N$="ALICE": LSET I$=MKI$(-1234): LSET S$=MKS$(3.14159): LSET D$=MKD$(1/3)
>40 PUT 1
>50 RSET N$="BOB": LSET I$=MKI$(31000): LSET S$=MKS$(-.5): LSET D$=MKD$(10000000000)
>60 PUT 1
>70 LSET N$="CAROL": LSET I$=MKI$(0): LSET S$=MKS$(100): LSET D$=MKD$(-2.5)
>80 PUT 1, 5
>90 CLOSE
>100 OPEN "R",2,"TRND.DAT",24
>110 FIELD 2, 10 AS N$, 2 AS I$, 4 AS S$, 8 AS D$
>120 PRINT "LOF=";LOF(2)
>130 GET 2, 2
>140 PRINT "[";N$;"]";CVI(I$);CVS(S$);CVD(D$)
>150 GET 2, 1
>160 PRINT "[";N$;"]";CVI(I$);CVS(S$);CVD(D$)
>170 GET 2, 5
>180 PRINT "[";N$;"]";CVI(I$);CVS(S$);CVD(D$);"LOC=";LOC(2);"EOF=";EOF(2)
>190 GET 2, 3
>200 PRINT "GAP: [";N$;"]";CVI(I$)
>210 CLOSE
>220 KILL "TRND.DAT"
>230 END
>RUN
LOF= 5 
[       BOB] 31000 -.5  10000000000 
[ALICE     ]-1234  3.14159  .3333333432674408 
[CAROL     ] 0  100 -2.5 LOC= 5 EOF=-1 
GAP: [          ] 8224 
READY
>BYE
exit=0
