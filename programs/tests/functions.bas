10 REM Built-in functions the suite did not pin (the 2026-09-23 audit,
20 REM M-13): plain values a mutation could change without a test
30 REM noticing, and the ?FC/?BS cases through an ON ERROR handler.
40 F=0:ON ERROR GOTO 900
50 IF SGN(0)<>0 OR SGN(-3)<>-1 OR SGN(2)<>1 THEN PRINT "FAIL: SGN":F=1
60 IF ABS(LOG(100)-4.60517)>1E-5 THEN PRINT "FAIL: LOG IS NATURAL";LOG(100):F=1
70 IF ABS(EXP(1)-2.71828)>1E-5 THEN PRINT "FAIL: EXP(1)";EXP(1):F=1
80 IF ABS(ATN(1)-.785398)>1E-5 OR ABS(TAN(.5)-.546302)>1E-5 THEN PRINT "FAIL: ATN/TAN";ATN(1);TAN(.5):F=1
90 IF ABS(SIN(1)-.841471)>1E-5 OR ABS(COS(1)-.540302)>1E-5 THEN PRINT "FAIL: SIN/COS";SIN(1);COS(1):F=1
100 IF FIX(-2.5)<>-2 OR INT(-2.5)<>-3 OR FIX(2.5)<>2 OR INT(-.5)<>-1 THEN PRINT "FAIL: FIX/INT":F=1
110 IF SQR(16)<>4 OR ABS(-3)<>3 OR RND(1)<>1 THEN PRINT "FAIL: SQR/ABS/RND(1)":F=1
120 IF INSTR(3,"ABCABC","A")<>4 OR INSTR("ABC","D")<>0 OR INSTR("ABC","C")<>3 THEN PRINT "FAIL: INSTR":F=1
130 A$="ABCDE"
140 IF MID$(A$,2)<>"BCDE" OR MID$(A$,2,2)<>"BC" OR LEFT$(A$,9)<>A$ OR RIGHT$(A$,2)<>"DE" OR MID$(A$,9)<>"" THEN PRINT "FAIL: MID$/LEFT$/RIGHT$":F=1
150 PRINT "AB";:P=POS(0):PRINT:IF P<>2 THEN PRINT "FAIL: POS AFTER AB IS";P:F=1
160 REM TAB past 63 wraps: 213AH masks the column with 3FH in the listing
170 REM followed (the revisions before 1.3, which changed it to 7FH)
180 PRINT TAB(70);"X";:P=POS(0):PRINT:IF P<>7 THEN PRINT "FAIL: TAB(70) LANDED AT";P:F=1
190 A(10)=7:IF A(10)<>7 THEN PRINT "FAIL: AUTO-DIM 10":F=1
200 REM --- the errors: ?FC (5) and ?BS (9) through the handler
210 S=1:X=SQR(-1)
220 IF S<>2 THEN PRINT "FAIL: SQR(-1) WAS NOT ?FC  S=";S:F=1
230 S=3:A$=MID$("AB",0)
240 IF S<>4 THEN PRINT "FAIL: MID$(A$,0) WAS NOT ?FC  S=";S:F=1
250 S=5:A$=LEFT$("AB",-1)
260 IF S<>6 THEN PRINT "FAIL: LEFT$(A$,-1) WAS NOT ?FC  S=";S:F=1
270 S=7:X=A(11)
280 IF S<>8 THEN PRINT "FAIL: A(11) PAST THE AUTO-DIM WAS NOT ?BS  S=";S:F=1
290 S=9:X=LOG(0)
300 IF S<>10 THEN PRINT "FAIL: LOG(0) WAS NOT ?FC  S=";S:F=1
301 REM --- a string function's count, and MID$'s position, are bytes (2568H and 2AADH -> 2B1CH):
302 REM ?FC past 255, ?OV outside the integer range; 255 itself is taken
303 IF LEFT$("ABC",255)<>"ABC" OR RIGHT$("ABC",255)<>"ABC" OR MID$("ABC",1,255)<>"ABC" THEN PRINT "FAIL: A COUNT OF 255":F=1
304 S=11:A$=LEFT$("ABC",256):IF S<>12 THEN PRINT "FAIL: LEFT$(A$,256) WAS NOT ?FC  S=";S:F=1
305 S=13:A$=RIGHT$("ABC",256):IF S<>14 THEN PRINT "FAIL: RIGHT$(A$,256) WAS NOT ?FC  S=";S:F=1
306 S=15:A$=MID$("ABC",256):IF S<>16 THEN PRINT "FAIL: MID$(A$,256) WAS NOT ?FC  S=";S:F=1
307 S=17:A$=MID$("ABC",1,256):IF S<>18 THEN PRINT "FAIL: MID$(A$,1,256) WAS NOT ?FC  S=";S:F=1
308 S=19:A$=LEFT$("ABC",40000):IF S<>20 THEN PRINT "FAIL: LEFT$(A$,40000) WAS NOT ?OV  S=";S:F=1
310 ON ERROR GOTO 0:IF F THEN PRINT "FUNCTIONS FIXTURE FAILED":ERROR 5
320 PRINT "FUNCTIONS FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3 OR S=5 OR S=9) AND C=5 THEN S=S+1:RESUME NEXT
915 IF (S=11 OR S=13 OR S=15 OR S=17) AND C=5 THEN S=S+1:RESUME NEXT
920 IF S=7 AND C=9 THEN S=8:RESUME NEXT
925 IF S=19 AND C=6 THEN S=20:RESUME NEXT
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
