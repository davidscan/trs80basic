10 REM The cursor codes 23-27 at the screen's edges, as the ROM's video
20 REM driver has them (04DA-0505, and the fold into 3C00-3FFFH at 0480).
30 REM The four arrows never leave the screen and never scroll it; left
40 REM and right stay in their own line.  The 2026-09-19 audit, L-1.
50 REM P is where the cursor is: the driver's DCB at 4020H, less 3C00H.
60 DEF FNP(X)=PEEK(16416)+256*PEEK(16417)-15360
70 F=0:CLS
100 PRINT@128,"";:PRINT CHR$(24);:W=191:GOSUB 900
110 PRINT@130,"";:PRINT CHR$(24);:W=129:GOSUB 900
120 PRINT@0,"";:PRINT CHR$(24);:W=63:GOSUB 900
200 PRINT@191,"";:PRINT CHR$(25);:W=128:GOSUB 900
210 PRINT@1023,"";:PRINT CHR$(25);:W=960:GOSUB 900
220 PRINT@5,"";:PRINT CHR$(25);:W=6:GOSUB 900
300 POKE 15360+965,77:PRINT@965,"";:PRINT CHR$(26);:W=5:GOSUB 900
310 IF PEEK(15360+965)<>77 THEN PRINT "FAIL: DOWN FROM THE LAST LINE SCROLLED":F=1
320 PRINT@70,"";:PRINT CHR$(26);:W=134:GOSUB 900
400 PRINT@5,"";:PRINT CHR$(27);:W=965:GOSUB 900
410 PRINT@134,"";:PRINT CHR$(27);:W=70:GOSUB 900
500 REM 32 columns: left steps two bytes, each with its own wrap; right one
510 CLS:PRINT CHR$(23);:W=0:GOSUB 900
520 PRINT@10,"";:PRINT CHR$(24);:W=8:GOSUB 900
530 PRINT@64,"";:PRINT CHR$(24);:W=126:GOSUB 900
540 PRINT@10,"";:PRINT CHR$(25);:W=11:GOSUB 900
600 REM 23 on an odd byte goes UP to the next even one; on an even one stays
610 CLS:PRINT@7,"";:PRINT CHR$(23);:W=8:GOSUB 900
620 CLS:PRINT@8,"";:PRINT CHR$(23);:W=8:GOSUB 900
630 CLS:PRINT@1023,"";:PRINT CHR$(23);:W=0:GOSUB 900
700 CLS:IF F THEN PRINT "CURSOR FIXTURE FAILED (WANTED/GOT):";Z$:ERROR 5
710 PRINT "CURSOR FIXTURE OK":END
900 P=FNP(0):IF P<>W THEN F=1:Z$=Z$+STR$(W)+"/"+STR$(P)
910 RETURN
