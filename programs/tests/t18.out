READY
>ext on
READY
>10 INPUT ""+CHR$(62)+"NAME";A$
>20 PRINT "GOT ";A$
>30 INPUT "AGE"+STR$(1);B
>40 PRINT B+1
>50 LINE INPUT "L"+STR$(5)+": ";C$
>60 PRINT "LINE=";C$
>RUN
>NAME? BOB
GOT BOB
AGE 1? 41
 42 
L 5: some line text
LINE=some line text
READY
>NEW
READY
>ext off
READY
>5 CLEAR 100
>10 DEFSTR A,S-U
>20 A="HELLO":S="WORLD":PRINT A;" ";S
>30 T(2)="ARR":PRINT T(2)
>40 READ U:PRINT U
>50 DATA DSTR
>60 DEFINT S:S=7:PRINT S+1
>70 CLEAR 50:DEFSTR A:A="RETYPED":PRINT A
>80 INPUT "P";A
>90 PRINT "GOT ";A
>RUN
HELLO WORLD
ARR
DSTR
 8 
RETYPED
P? typed
GOT typed
READY
>NEW
READY
>DEFSTR Q
READY
>Q="DIRECT"
READY
>PRINT Q
DIRECT
READY
>10 Q=1
>RUN
READY
>BYE
exit=0
