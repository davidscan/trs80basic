10 REM ERROR n takes its code through the ROM's byte evaluator (1FF4 ->
20 REM 2B1CH), so a code outside 0-255 is ?FC and one outside the integer
30 REM range is ?OV; 0 is ?FC at 1FF9; a code past the table is ?UE at 2003.
40 F=0:ON ERROR GOTO 900
50 S=1:ERROR 0
60 IF S<>2 THEN PRINT "FAIL: ERROR 0 WAS NOT ?FC  S=";S:F=1
70 S=3:ERROR -1
80 IF S<>4 THEN PRINT "FAIL: ERROR -1 WAS NOT ?FC  S=";S:F=1
90 S=5:ERROR 256
100 IF S<>6 THEN PRINT "FAIL: ERROR 256 WAS NOT ?FC  S=";S:F=1
110 S=7:ERROR 70000
120 IF S<>8 THEN PRINT "FAIL: ERROR 70000 WAS NOT ?OV  S=";S:F=1
130 REM a code the table has still names its own error
140 S=9:ERROR 5
150 IF S<>10 THEN PRINT "FAIL: ERROR 5 WAS NOT ?FC  S=";S:F=1
160 S=11:ERROR 23
170 IF S<>12 THEN PRINT "FAIL: ERROR 23 WAS NOT ?L3  S=";S:F=1
180 REM past the end of the table: ?UE, as the ROM does at 2003
190 S=13:ERROR 32
200 IF S<>14 THEN PRINT "FAIL: ERROR 32 WAS NOT ?UE  S=";S:F=1
210 S=15:ERROR 255
220 IF S<>16 THEN PRINT "FAIL: ERROR 255 WAS NOT ?UE  S=";S:F=1
230 REM a NEGATIVE subscript is ?FC where the ROM evaluates it (1E45-1E4C),
240 REM in a reference and in DIM alike; a subscript past the bound stays ?BS
250 DIM Q(5)
260 S=17:Q(-1)=1
270 IF S<>18 THEN PRINT "FAIL: Q(-1)= WAS NOT ?FC  S=";S:F=1
280 S=19:X=Q(-2)
290 IF S<>20 THEN PRINT "FAIL: =Q(-2) WAS NOT ?FC  S=";S:F=1
300 S=21:DIM W(-1)
310 IF S<>22 THEN PRINT "FAIL: DIM W(-1) WAS NOT ?FC  S=";S:F=1
320 S=23:X=Q(6)
330 IF S<>24 THEN PRINT "FAIL: Q(6) WAS NOT ?BS  S=";S:F=1
340 REM MKI$ out of range is the Disk manual's ILLEGAL FUNCTION CALL (p.144),
350 REM not ?OV; the fraction is dropped downward, as CINT drops it
360 S=25:A$=MKI$(32768)
370 IF S<>26 THEN PRINT "FAIL: MKI$(32768) WAS NOT ?FC  S=";S:F=1
380 S=27:A$=MKI$(-32769)
390 IF S<>28 THEN PRINT "FAIL: MKI$(-32769) WAS NOT ?FC  S=";S:F=1
400 S=0:A$=MKI$(32767):IF CVI(A$)<>32767 THEN PRINT "FAIL: MKI$(32767)":F=1
410 A$=MKI$(-32768):IF CVI(A$)<>-32768 THEN PRINT "FAIL: MKI$(-32768)":F=1
420 A$=MKI$(-1.5):IF CVI(A$)<>-2 THEN PRINT "FAIL: MKI$(-1.5)=";CVI(A$):F=1
800 ON ERROR GOTO 0:IF F THEN PRINT "ERRCODE FIXTURE FAILED":ERROR 5
810 PRINT "ERRCODE FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3 OR S=5) AND C=5 THEN S=S+1:RESUME NEXT
920 IF S=7 AND C=6 THEN S=8:RESUME NEXT
930 IF S=9 AND C=5 THEN S=10:RESUME NEXT
940 IF S=11 AND C=23 THEN S=12:RESUME NEXT
950 IF (S=13 OR S=15) AND C=20 THEN S=S+1:RESUME NEXT
952 IF (S=17 OR S=19 OR S=21) AND C=5 THEN S=S+1:RESUME NEXT
954 IF S=23 AND C=9 THEN S=24:RESUME NEXT
956 IF (S=25 OR S=27) AND C=5 THEN S=S+1:RESUME NEXT
960 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
