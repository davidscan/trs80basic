10 REM ERROR n takes its code through the ROM's byte evaluator (1FF4 ->
20 REM 2B1CH), so a code outside 0-255 is ?FC and one outside the integer
30 REM range is ?OV; 0 is ?FC at 1FF9; a code past the table is ?UE at 2003.
40 CLEAR 2000:F=0:ON ERROR GOTO 900
50 S=1:ERROR 0
60 IF S<>2 THEN PRINT "FAIL: ERROR 0 WAS NOT ?FC  S=";S:F=1
70 S=3:ERROR -1
80 IF S<>4 THEN PRINT "FAIL: ERROR -1 WAS NOT ?FC  S=";S:F=1
90 S=5:ERROR 256
100 IF S<>6 THEN PRINT "FAIL: ERROR 256 WAS NOT ?FC  S=";S:F=1
110 S=7:ERROR 70000
120 IF S<>8 THEN PRINT "FAIL: ERROR 70000 WAS NOT ?OV  S=";S:F=1
130 REM a code the table has still names its own error
140 S=9:ERROR 5
150 IF S<>10 THEN PRINT "FAIL: ERROR 5 WAS NOT ?FC  S=";S:F=1
160 S=11:ERROR 23
170 IF S<>12 THEN PRINT "FAIL: ERROR 23 WAS NOT ?L3  S=";S:F=1
180 REM past the end of the table: ?UE, as the ROM does at 2003
190 S=13:ERROR 32
200 IF S<>14 THEN PRINT "FAIL: ERROR 32 WAS NOT ?UE  S=";S:F=1
210 S=15:ERROR 255
220 IF S<>16 THEN PRINT "FAIL: ERROR 255 WAS NOT ?UE  S=";S:F=1
222 REM a file code is ?UE too: "Disk errors cannot be simulated via the ERROR statement" (Disk manual p.156)
224 S=41:ERROR 54
226 IF S<>42 THEN PRINT "FAIL: ERROR 54 (FILE NOT FOUND) WAS NOT ?UE  S=";S:F=1
227 S=43:ERROR 24
229 IF S<>44 THEN PRINT "FAIL: ERROR 24 (A GAP) WAS NOT ?UE  S=";S:F=1
230 REM a NEGATIVE subscript is ?FC where the ROM evaluates it (1E45-1E4C),
240 REM in a reference and in DIM alike; a subscript past the bound stays ?BS
250 DIM Q(5)
260 S=17:Q(-1)=1
270 IF S<>18 THEN PRINT "FAIL: Q(-1)= WAS NOT ?FC  S=";S:F=1
280 S=19:X=Q(-2)
290 IF S<>20 THEN PRINT "FAIL: =Q(-2) WAS NOT ?FC  S=";S:F=1
300 S=21:DIM W(-1)
310 IF S<>22 THEN PRINT "FAIL: DIM W(-1) WAS NOT ?FC  S=";S:F=1
320 S=23:X=Q(6)
330 IF S<>24 THEN PRINT "FAIL: Q(6) WAS NOT ?BS  S=";S:F=1
340 REM MKI$ out of range is the Disk manual's ILLEGAL FUNCTION CALL (p.144),
350 REM not ?OV; the fraction is dropped downward, as CINT drops it
360 S=25:A$=MKI$(32768)
370 IF S<>26 THEN PRINT "FAIL: MKI$(32768) WAS NOT ?FC  S=";S:F=1
380 S=27:A$=MKI$(-32769)
390 IF S<>28 THEN PRINT "FAIL: MKI$(-32769) WAS NOT ?FC  S=";S:F=1
400 S=0:A$=MKI$(32767):IF CVI(A$)<>32767 THEN PRINT "FAIL: MKI$(32767)":F=1
410 A$=MKI$(-32768):IF CVI(A$)<>-32768 THEN PRINT "FAIL: MKI$(-32768)":F=1
420 A$=MKI$(-1.5):IF CVI(A$)<>-2 THEN PRINT "FAIL: MKI$(-1.5)=";CVI(A$):F=1
430 REM EXP's ceiling is the ROM's (1439-1454), not the float range: it
440 REM overflows once INT(X/LN2) reaches 126, so 87.3365 up is ?OV -- the
450 REM value there is only 8.5E37.  Below -128*LN2 the same exit (0931H)
455 REM tests the sign and returns 0: a negative argument is never ?OV.
460 S=0:IF EXP(87.336)<8.5E37 OR EXP(87.336)>8.51E37 THEN PRINT "FAIL: EXP(87.336)=";EXP(87.336):F=1
470 S=29:X=EXP(87.34)
480 IF S<>30 THEN PRINT "FAIL: EXP(87.34) WAS NOT ?OV  S=";S:F=1
490 S=31:X=EXP(88)
500 IF S<>32 THEN PRINT "FAIL: EXP(88) WAS NOT ?OV  S=";S:F=1
510 S=0:IF EXP(-88.7)<3E-39 OR EXP(-88.7)>3.01E-39 THEN PRINT "FAIL: EXP(-88.7)":F=1
520 S=0:IF EXP(-89)<>0 THEN PRINT "FAIL: EXP(-89) IS NOT 0":F=1
530 IF EXP(-200)<>0 THEN PRINT "FAIL: EXP(-200) IS NOT 0":F=1
540 S=0:IF EXP(0)<>1 THEN PRINT "FAIL: EXP(0)":F=1
550 REM a string is at most 255 characters: + adds the two lengths in a
560 REM byte and a carry is ?LS (ROM 299C-29A5); the store does not happen
570 S=0:A$=STRING$(200,"A")+STRING$(55,"B")
580 IF LEN(A$)<>255 OR PEEK(VARPTR(A$))<>255 THEN PRINT "FAIL: 200+55 IS NOT 255":F=1
590 S=33:B$=A$+"C"
600 IF S<>34 THEN PRINT "FAIL: 255+1 WAS NOT ?LS  S=";S:F=1
610 S=35:B$=A$+A$
620 IF S<>36 THEN PRINT "FAIL: 255+255 WAS NOT ?LS  S=";S:F=1
630 S=0:IF B$<>"" THEN PRINT "FAIL: B$ WAS STORED, LEN";LEN(B$):F=1
640 B$=A$+"":IF LEN(B$)<>255 THEN PRINT "FAIL: 255+0":F=1
700 REM --- ?OV at the single-precision maximum, not below it: 1.70141E38 is a number (the largest
702 REM MBF value is (1-2^-24)*2^127), 1.70142E38 rounds into an exponent byte of 256 (07B2H)
710 S=0:A=1.70141E38:IF STR$(A)<>" 1.70141E+38" THEN PRINT "FAIL: 1.70141E38 IS A NUMBER";A:F=1
712 A=-1.70141E38:IF STR$(A)<>"-1.70141E+38" THEN PRINT "FAIL: -1.70141E38 IS A NUMBER";A:F=1
714 A=8.5E37*2:IF STR$(A)<>" 1.7E+38" THEN PRINT "FAIL: 8.5E37*2 IS 1.7E38";A:F=1
716 A=VAL("1.70141E38"):IF STR$(A)<>" 1.70141E+38" THEN PRINT "FAIL: VAL(1.70141E38)";A:F=1
720 S=45:A=1.70142E38:IF S<>46 THEN PRINT "FAIL: 1.70142E38 WAS NOT ?OV  S=";S:F=1
722 S=47:A=8.51E37*2:IF S<>48 THEN PRINT "FAIL: 8.51E37*2 WAS NOT ?OV  S=";S:F=1
724 S=49:A=VAL("1.70142E38"):IF S<>50 THEN PRINT "FAIL: VAL(1.70142E38) WAS NOT ?OV  S=";S:F=1
726 S=51:A=1.4E19*1.4E19:IF S<>52 THEN PRINT "FAIL: 1.4E19*1.4E19 WAS NOT ?OV  S=";S:F=1
728 S=53:A=-8.51E37-8.51E37:IF S<>54 THEN PRINT "FAIL: -8.51E37-8.51E37 WAS NOT ?OV  S=";S:F=1
800 ON ERROR GOTO 0:IF F THEN PRINT "ERRCODE FIXTURE FAILED":ERROR 5
810 PRINT "ERRCODE FIXTURE OK":END
900 C=ERR/2+1
910 IF (S=1 OR S=3 OR S=5) AND C=5 THEN S=S+1:RESUME NEXT
920 IF S=7 AND C=6 THEN S=8:RESUME NEXT
930 IF S=9 AND C=5 THEN S=10:RESUME NEXT
940 IF S=11 AND C=23 THEN S=12:RESUME NEXT
950 IF (S=13 OR S=15) AND C=20 THEN S=S+1:RESUME NEXT
952 IF (S=17 OR S=19 OR S=21) AND C=5 THEN S=S+1:RESUME NEXT
954 IF S=23 AND C=9 THEN S=24:RESUME NEXT
956 IF (S=25 OR S=27) AND C=5 THEN S=S+1:RESUME NEXT
958 IF (S=29 OR S=31) AND C=6 THEN S=S+1:RESUME NEXT
959 IF (S=41 OR S=43) AND C=20 THEN S=S+1:RESUME NEXT
960 IF (S=33 OR S=35) AND C=15 THEN S=S+1:RESUME NEXT
962 IF (S=45 OR S=47 OR S=49 OR S=51 OR S=53) AND C=6 THEN S=S+1:RESUME NEXT
970 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME NEXT
