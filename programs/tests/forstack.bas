10 REM FOR and NEXT stop their scan of the stack at the GOSUB frame (ROM
20 REM 1936H): a subroutine cannot see, reuse or NEXT its caller's loops.
30 F=0:ON ERROR GOTO 900
40 REM --- a delay subroutine reusing the caller's variable: the caller's
50 REM     loop SURVIVES; its NEXT then sees I=11 and the loop ends clean
60 N=0:FOR I=1 TO 3:N=N+1:GOSUB 500:NEXT I
70 IF N<>1 THEN PRINT "FAIL: CALLER'S LOOP RAN";N;"TIMES, WANTED 1":F=1
80 REM --- with its own variable the subroutine leaves the caller counting
90 N=0:FOR I=1 TO 3:N=N+1:GOSUB 600:NEXT I
100 IF N<>3 THEN PRINT "FAIL: INDEPENDENT LOOP RAN";N;"TIMES":F=1
110 REM --- NEXT of a loop opened before the GOSUB is ?NF in the subroutine
120 S=1:FOR K=1 TO 2:GOSUB 700
130 IF S<>2 THEN PRINT "FAIL: NEXT K INSIDE THE SUBROUTINE WAS NOT ?NF, S=";S:F=1
140 REM --- a bare NEXT in a subroutine with no loop of its own: ?NF too
150 S=3:FOR K=1 TO 2:GOSUB 750
160 IF S<>4 THEN PRINT "FAIL: BARE NEXT INSIDE THE SUBROUTINE WAS NOT ?NF, S=";S:F=1
170 REM --- RETURN out of a loop still discards the subroutine's frames
180 FOR M=1 TO 2:GOSUB 800:NEXT M
190 IF M<>3 THEN PRINT "FAIL: EARLY RETURN LEFT A STALE FRAME, M=";M:F=1
200 REM --- nested GOSUBs: the floor is the INNERMOST frame's
210 N=0:FOR I=1 TO 2:GOSUB 850:NEXT I
220 IF N<>2 THEN PRINT "FAIL: NESTED GOSUB, N=";N:F=1
230 ON ERROR GOTO 0:IF F THEN PRINT "FORSTACK FIXTURE FAILED":ERROR 5
240 PRINT "FORSTACK FIXTURE OK":END
500 FOR I=1 TO 10:NEXT I:RETURN
600 FOR J=1 TO 10:NEXT J:RETURN
700 NEXT K
710 S=99:RETURN
750 NEXT
760 S=99:RETURN
800 FOR Q=1 TO 5:IF Q=2 THEN RETURN
810 NEXT Q:RETURN
850 FOR J=1 TO 2:GOSUB 870:NEXT J:N=N+1:RETURN
870 FOR J=1 TO 3:NEXT J:RETURN
900 C=ERR/2+1
910 IF S=1 AND C=1 AND ERL=700 THEN S=2:RESUME 130
920 IF S=3 AND C=1 AND ERL=750 THEN S=4:RESUME 160
930 PRINT "FAIL: UNEXPECTED ERROR";C;"IN";ERL;"S=";S:F=1:RESUME 230
