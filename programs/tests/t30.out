B
SN AT 0 -1 
CMD AS VARIABLESN AT 0 -1 
SN AT 1 -1 
SN AT 2 -1 
SN AT 3 -1 
SN AT 4 -1 
TRAPPED 6 
READY
>cmd"&"&
