10 REM IF expr,... : the ROM skips one comma after the expression (203C-203F)
20 F=0
30 X=1:IF X=1,60
40 PRINT "FAIL: IF X=1,60 DID NOT JUMP":F=1
50 GOTO 70
60 PRINT "OK 1"
70 IF X=1,THEN 100
80 PRINT "FAIL: IF X=1,THEN 100 DID NOT JUMP":F=1
90 GOTO 110
100 PRINT "OK 2"
110 Y=0:IF X=1,Y=7
120 IF Y<>7 THEN PRINT "FAIL: IF X=1,Y=7 DID NOT ASSIGN":F=1 ELSE PRINT "OK 3"
130 Z=0:IF X=2,Z=1 ELSE Z=2
140 IF Z<>2 THEN PRINT "FAIL: FALSE BRANCH WITH COMMA, Z=";Z:F=1 ELSE PRINT "OK 4"
150 IF X=2,999 ELSE 170
160 PRINT "FAIL: ELSE LINE NOT TAKEN":F=1
170 IF X=1,GOTO 190
180 PRINT "FAIL: IF X=1,GOTO 190 DID NOT JUMP":F=1
190 W=0:IF X=1 THEN W=1
200 IF W<>1 THEN PRINT "FAIL: PLAIN THEN BROKE":F=1
210 IF F THEN PRINT "IFCOMMA FIXTURE FAILED":ERROR 5
220 PRINT "IFCOMMA OK"
