10 REM LOGBOOK -- a ship's log kept in a text file.
20 REM Sequential I/O: OPEN "O"/"E"/"I", PRINT#, LINE INPUT#, EOF, LOC,
30 REM plus ON ERROR to notice the file is missing on the first run.
40 F$="LOGBOOK.TXT": CLS
50 ON ERROR GOTO 400
60 OPEN "I",1,F$: CLOSE 1: PRINT "OPENING EXISTING LOG.": GOTO 100
100 ON ERROR GOTO 0
110 READ D$: IF D$="END" THEN 200
120 OPEN "E",1,F$: PRINT #1,D$: CLOSE 1
130 PRINT "LOGGED: ";D$: GOTO 110
200 PRINT: PRINT "--- FULL LOG ---": N=0
210 OPEN "I",1,F$
220 IF EOF(1) THEN 260
230 LINE INPUT #1,L$: N=N+1
240 PRINT USING "##  ";N;: PRINT L$
250 GOTO 220
260 PRINT "LOC(1) SAYS";LOC(1);"LINES READ.": CLOSE 1
270 KILL F$: PRINT "(LOG DELETED SO THE NEXT RUN STARTS FRESH)": END
400 REM error handler: ERR/2+1 is the classic error code, 54 = FF, file not found (Disk BASIC's number)
410 IF ERR/2+1<>54 THEN PRINT "UNEXPECTED ERROR";ERR/2+1;"AT";ERL: END
420 PRINT "NO LOG YET -- STARTING ONE.": OPEN "O",1,F$: CLOSE 1
430 RESUME 100
500 DATA "0800 CAST OFF, WIND NW 12KT"
510 DATA "1130 SIGHTED WHALE OFF PORT BOW"
520 DATA "1500 FIRST MATE LOST AT CARDS"
530 DATA "1800 ANCHORED, ALL WELL"
540 DATA "END"
