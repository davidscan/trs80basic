10 CLEAR 2000: CLS
20 DIM R(15,5), IL(15), I$(15), D$(15), V$(15), N$(20)
30 ' --- LOAD VOCABULARY ---
40 FOR X=1 TO 10: READ V$(X): NEXT X
50 DATA "GO","GET","DROP","INVENTORY","LOOK","EXAMINE","TALK","USE","GIVE","READ"
60 FOR X=1 TO 15: READ N$(X): NEXT X
70 DATA "NORTH","SOUTH","EAST","WEST","UP","DOWN","MOP","FORM","COIN"
80 DATA "DOOR","TOASTER","ORACLE","SLOT","SHIP","BUTTON"
90 ' --- LOAD ROOMS (DESC, N, S, E, W, U, D) 0=NO EXIT ---
100 FOR X=1 TO 10
110 READ D$(X): FOR Y=0 TO 5: READ R(X,Y): NEXT Y
120 NEXT X
130 DATA "A DAMP MAINTENANCE CLOSET. IT SMELLS OF RUST AND DISAPPOINTMENT. EXITS: NORTH", 2, 0, 0, 0, 0, 0
140 DATA "DILAPIDATED PROMENADE. A NEON TUBE FLICKERS. EXITS: SOUTH, EAST, WEST, UP, DOWN", 0, 1, 3, 5, 9, 8
150 DATA "BUREAUCRATIC CHECKPOINT. A HEAVY SECURITY DOOR IS EAST. EXITS: WEST", 0, 0, 4, 2, 0, 0
160 DATA "EXECUTIVE SUITE. PREMIUM GREASE! ENDING 1", 0, 0, 0, 0, 0, 0
170 DATA "RUSTY JUNKYARD. PILES OF GARBAGE EVERYWHERE. EXITS: NORTH, SOUTH, EAST", 7, 6, 2, 0, 0, 0
180 DATA "THE VENDING MACHINE ORACLE'S DOMAIN. THE MACHINE HUMS. EXITS: NORTH", 5, 0, 0, 0, 0, 0
190 DATA "SPARKY'S NOOK. A SENTIENT TOASTER SITS ON A CRATE HERE. EXITS: SOUTH", 0, 5, 0, 0, 0, 0
200 DATA "THE MAKER CORE. ANCIENT MACHINERY GLOWS. ENDING 2", 0, 0, 0, 0, 0, 0
210 DATA "ABANDONED DOCKING BAY. A TRANSPORT SHIP RESTS HERE. EXITS: DOWN", 0, 0, 0, 0, 0, 2
220 DATA "INSIDE THE TRANSPORT SHIP. ENDING 3", 0, 0, 0, 0, 0, 0
230 ' --- LOAD ITEMS (LOC, NAME) ---
240 FOR X=1 TO 3
250 READ IL(X), I$(X): NEXT X
260 DATA 1,"MOP", 5,"FORM", 7,"COIN"
270 ' --- INITIALIZE GAME STATE ---
280 CR=1: F1=0: F2=0: F3=0
290 GOSUB 1000: ' LOOK
300 ' --- MAIN LOOP ---
310 GOSUB 8090: ' CHECK ENDINGS
320 PRINT: INPUT "WHAT NOW"; I$
330 GOSUB 2000: ' PARSE
340 IF V=0 THEN PRINT "I DON'T UNDERSTAND THAT.": GOTO 320
350 GOSUB 8000: ' EVENT INTERCEPT
360 IF EV=1 THEN EV=0: GOTO 320: ' EVENT HANDLED IT
370 IF V=1 THEN GOSUB 3000: GOTO 320: ' GO
380 IF V=2 THEN GOSUB 4000: GOTO 320: ' GET
390 IF V=3 THEN GOSUB 5000: GOTO 320: ' DROP
400 IF V=4 THEN GOSUB 6000: GOTO 320: ' INV
410 IF V=5 THEN GOSUB 1000: GOTO 320: ' LOOK
415 IF V=6 OR V=10 THEN GOSUB 7000: GOTO 320
420 PRINT "NOTHING HAPPENS.": GOTO 320
1000 ' --- LOOK SUBROUTINE ---
1010 PR$=D$(CR): GOSUB 10000
1020 FOR X=1 TO 3: IF IL(X)=CR THEN PR$="THERE IS A "+I$(X)+" HERE.": GOSUB 10000
1030 NEXT X: RETURN
2000 ' --- PARSER SUBROUTINE ---
2010 V=0: N=0: IF I$="" THEN RETURN
2020 IF I$="N" THEN I$="GO NORTH"
2030 IF I$="S" THEN I$="GO SOUTH"
2040 IF I$="E" THEN I$="GO EAST"
2050 IF I$="W" THEN I$="GO WEST"
2060 IF I$="U" THEN I$="GO UP"
2070 IF I$="D" THEN I$="GO DOWN"
2080 IF I$="I" THEN I$="INVENTORY"
2090 S1$="": S2$="": SP=0
2100 FOR X=1 TO LEN(I$): IF MID$(I$,X,1)=" " THEN SP=X: X=LEN(I$)
2110 NEXT X
2120 IF SP=0 THEN S1$=I$ ELSE S1$=LEFT$(I$,SP-1): S2$=MID$(I$,SP+1)
2130 FOR X=1 TO 9: IF S1$=V$(X) THEN V=X
2140 NEXT X
2150 IF S2$="" THEN RETURN
2160 FOR X=1 TO 15: IF S2$=N$(X) THEN N=X
2170 NEXT X: RETURN
3000 ' --- GO SUBROUTINE ---
3010 IF N<1 OR N>6 THEN PRINT "GO WHERE?": RETURN
3020 DR=N-1: NR=R(CR,DR)
3030 IF NR=0 THEN PRINT "YOU CAN'T GO THAT WAY.": RETURN
3040 CR=NR: GOSUB 1000: RETURN
4000 ' --- GET SUBROUTINE ---
4010 IT=0: IF N=0 THEN PRINT "GET WHAT?": RETURN
4020 FOR X=1 TO 3: IF I$(X)=N$(N) AND IL(X)=CR THEN IT=X
4030 NEXT X: IF IT=0 THEN PRINT "I DON'T SEE THAT HERE.": RETURN
4040 IL(IT)=-1: PRINT "TAKEN.": RETURN
5000 ' --- DROP SUBROUTINE ---
5010 IT=0: IF N=0 THEN PRINT "DROP WHAT?": RETURN
5020 FOR X=1 TO 3: IF I$(X)=N$(N) AND IL(X)=-1 THEN IT=X
5030 NEXT X: IF IT=0 THEN PRINT "YOU DON'T HAVE THAT.": RETURN
5040 IL(IT)=CR: PRINT "DROPPED.": RETURN
6000 ' --- INVENTORY SUBROUTINE ---
6010 CT=0: PRINT "YOU ARE CARRYING:"
6020 FOR X=1 TO 3: IF IL(X)=-1 THEN PRINT "  "+I$(X): CT=CT+1
6030 NEXT X: IF CT=0 THEN PRINT "  NOTHING BUT LINT."
6040 RETURN
7000 ' --- EXAMINE / READ SUBROUTINE ---
7010 IF N=0 THEN PRINT "EXAMINE WHAT?": RETURN
7020 IF N=7 THEN PR$="IT IS A STANDARD ISSUE RUSTY MOP.": GOSUB 10000: RETURN
7030 IF N=8 THEN PR$="FORM 27B/6: REQUEST FOR MAINTENANCE TIER 2 ACCESS.": GOSUB 10000: RETURN
7040 PRINT "YOU SEE NOTHING SPECIAL ABOUT IT.": RETURN
8000 ' --- EVENT HANDLER (PUZZLE LOGIC) ---
8010 EV=0
8020 IF CR=3 AND V=1 AND N=3 AND F1=0 THEN PR$="THE DOOR DEMANDS FORM 27B/6.": GOSUB 10000: EV=1: RETURN
8030 IF CR=3 AND N=8 AND IL(2)=-1 THEN PR$="YOU FEED THE FORM TO THE DOOR. IT BEEPS AND OPENS!": GOSUB 10000: F1=1: IL(2)=0: EV=1: RETURN
8040 IF CR=7 AND V=7 THEN PR$="SPARKY SAYS: 'GIVE THE COIN TO THE ORACLE TO REVEAL THE CORE!'": GOSUB 10000: EV=1: RETURN
8050 IF CR=6 AND N=9 AND IL(3)=-1 THEN PR$="THE ORACLE CHUGS THE COIN. THE PATH DOWN IS NOW OPEN!": GOSUB 10000: F2=1: IL(3)=0: EV=1: RETURN
8060 IF CR=2 AND V=1 AND N=6 AND F2=0 THEN PR$="A HEAVY BLAST SHIELD BLOCKS THE STAIRS DOWN.": GOSUB 10000: EV=1: RETURN
8070 IF CR=9 AND V=8 AND N=14 THEN PR$="THE SHIP IS BROKEN. MAYBE IF YOU HAD A TOOL...": GOSUB 10000: EV=1: RETURN
8080 IF CR=9 AND V=8 AND N=7 AND IL(1)=-1 THEN PR$="YOU JAM THE MOP INTO THE IGNITION. IT SPUTTERS TO LIFE! YOU LAUNCH!": GOSUB 10000: CR=10: EV=1: RETURN
8090 ' --- CHECK ENDINGS ---
8100 IF CR=4 THEN PRINT: PR$="CONGRATULATIONS. YOU GOT THE DESK JOB. ENDING 1: THE BUREAUCRATIC TRIUMPH.": GOSUB 10000: END
8110 IF CR=8 THEN PRINT: PR$="YOU ARE ONE WITH THE MAKERS. ENDING 2: THE ASCENDED TRIUMPH.": GOSUB 10000: END
8120 IF CR=10 THEN PRINT: PR$="YOU ESCAPE THE STATION WITH SPARKY. ENDING 3: THE ESCAPIST TRIUMPH.": GOSUB 10000: END
8130 RETURN
10000 ' --- WORD WRAP SUBROUTINE ---
10010 IF LEN(PR$)<=64 THEN PRINT PR$: RETURN
10020 L=64: FOR X=64 TO 1 STEP -1: IF MID$(PR$,X,1)=" " THEN L=X: X=1
10030 NEXT X
10040 PRINT LEFT$(PR$,L-1): PR$=MID$(PR$,L+1): GOTO 10010
